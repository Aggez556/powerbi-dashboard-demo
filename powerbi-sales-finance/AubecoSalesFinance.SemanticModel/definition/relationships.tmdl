relationship SalesToDatum
	fromColumn: Försäljning.Datumnyckel
	toColumn: Datum.Datumnyckel

relationship SalesToKunder
	fromColumn: Försäljning.Kundnyckel
	toColumn: Kunder.Kundnyckel

