	measure 'Säljanalys säljare 1 namn' =
			VAR _pool = FILTER(ADDCOLUMNS(ALLSELECTED('Säljare'), "__sales", CALCULATE([Omsättning])), [__sales] > 0)
			VAR _seller = TOPN(1, TOPN(1, _pool, [__sales], DESC, 'Säljare'[Säljarnyckel], ASC), [__sales], ASC, 'Säljare'[Säljarnyckel], DESC)
			VAR _enough = COUNTROWS(_pool) >= 1
			RETURN IF(_enough, MAXX(_seller, 'Säljare'[Säljare]))
		formatString: @
		isHidden
		displayFolder: Försäljningsanalys\Presentation
		lineageTag: 5a0ebed8-d9da-4397-a96a-1c5112f80691

	measure 'Säljanalys säljare 1 belopp' =
			VAR _pool = FILTER(ADDCOLUMNS(ALLSELECTED('Säljare'), "__sales", CALCULATE([Omsättning])), [__sales] > 0)
			VAR _seller = TOPN(1, TOPN(1, _pool, [__sales], DESC, 'Säljare'[Säljarnyckel], ASC), [__sales], ASC, 'Säljare'[Säljarnyckel], DESC)
			VAR _enough = COUNTROWS(_pool) >= 1
			RETURN IF(_enough, SUMX(_seller, [__sales]))
		formatString: #,##0" kr"
		isHidden
		displayFolder: Försäljningsanalys\Presentation
		lineageTag: fec5256f-8bba-45d5-bc36-d5cb56d277b8

	measure 'Säljanalys säljare 1 tillväxt' =
			VAR _pool = FILTER(ADDCOLUMNS(ALLSELECTED('Säljare'), "__sales", CALCULATE([Omsättning])), [__sales] > 0)
			VAR _seller = TOPN(1, TOPN(1, _pool, [__sales], DESC, 'Säljare'[Säljarnyckel], ASC), [__sales], ASC, 'Säljare'[Säljarnyckel], DESC)
			VAR _enough = COUNTROWS(_pool) >= 1
			VAR _current = SUMX(_seller, [__sales])
			VAR _prior = SUMX(_seller, CALCULATE([Omsättning föregående år]))
			RETURN IF(_enough, DIVIDE(_current - _prior, _prior))
		formatString: +0.0 %;-0.0 %;0.0 %
		isHidden
		displayFolder: Försäljningsanalys\Presentation
		lineageTag: db5a6de9-7118-42fd-84cd-e595a3596045

	measure 'Säljanalys säljare 1 initialer' =
