	measure 'Finans marknadstillväxt etikett' =
			VAR _value = [Bruttovinst YoY]
			RETURN IF(NOT ISBLANK(_value), FORMAT(_value, "+0.0 %;-0.0 %;0.0 %", "sv-SE") & IF(_value > 0, " ▲", IF(_value < 0, " ▼", " –")))
		formatString: @
