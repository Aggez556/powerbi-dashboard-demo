/// Lokal testdata från FactSales.csv.
table Försäljning
	lineageTag: 9daaf37f-798b-4552-a222-34cffb041b61

	/// Nettoomsättning exklusive moms efter rabatt.
	measure Omsättning = SUM('Försäljning'[Radomsättning])
		formatString: #,##0.00 " kr"
		displayFolder: Nyckeltal
		lineageTag: 23e934b6-2350-4722-ba90-5c35a17b2464

	/// Varukostnad; exkluderar rörelsekostnader.
	measure Kostnad = SUM('Försäljning'[Radkostnad])
		formatString: #,##0.00 " kr"
		displayFolder: Nyckeltal
		lineageTag: 44901f4a-35d6-48ba-8e24-583df298b996

	/// Omsättning minus varukostnad.
	measure Bruttovinst = [Omsättning] - [Kostnad]
		formatString: #,##0.00 " kr"
		displayFolder: Nyckeltal
		lineageTag: 3745bce8-db56-4e71-9f68-b3209070644b

	/// Viktad marginal; inte medelvärdet av produktmarginalerna.
	measure Bruttomarginal = DIVIDE([Bruttovinst], [Omsättning])
		formatString: 0.0 %
		displayFolder: Nyckeltal
		lineageTag: 36d8949f-1fca-40e9-95c0-1fbb4ac23569

	/// Unika order med minst en orderrad i aktuellt filter.
	measure 'Antal order' = DISTINCTCOUNT('Försäljning'[Ordernyckel])
		formatString: #,##0
		displayFolder: Nyckeltal
		lineageTag: 30469afa-6412-4aee-91e0-527fdbbee847

	/// Omsättning för motsvarande kalenderdatum föregående år; 2023 saknas.
	measure 'Omsättning föregående år' = CALCULATE([Omsättning], SAMEPERIODLASTYEAR('Datum'[Datum]))
		formatString: #,##0.00 " kr"
		displayFolder: Nyckeltal
		lineageTag: eb7fb9b7-47bc-4036-80e5-991744266cbf

	/// Visas endast vid ett valt år och tillgänglig jämförelse; annars blank.
	measure 'Tillväxt mot föregående år' = IF(HASONEVALUE('Datum'[År]), DIVIDE([Omsättning] - [Omsättning föregående år], [Omsättning föregående år]), BLANK())
		formatString: 0.0 %;-0.0 %;0.0 %
		displayFolder: Nyckeltal
		lineageTag: ec422f5f-6c7e-4e7e-983b-8748d8e110e2

	/// Antal orderrader i aktuellt filter.
	measure 'Antal orderrader' = COUNTROWS('Försäljning')
		formatString: #,##0
		displayFolder: Nyckeltal
		lineageTag: ad76836e-6cd4-463f-820e-d9f7768fd2e0

	/// Kundrankning inom aktuellt urval; lika belopp delar rankning.
	measure Kundrankning = RANKX(ALLSELECTED('Kunder'[Kund]), [Omsättning], , DESC, DENSE)
		formatString: 0
		displayFolder: Nyckeltal
		lineageTag: 031d8aea-22e9-4a2f-a9eb-7b5ec3f8e491

	measure 'Omsättning miljoner' = [Omsättning] / 1000000
		formatString: 0.0" mn kr"
		displayFolder: Ledningsöversikt
		lineageTag: 40cb6d6b-9246-45d9-9568-89e521246516

	measure 'Bruttovinst miljoner' = [Bruttovinst] / 1000000
		formatString: 0.0" mn kr"
		displayFolder: Ledningsöversikt
		lineageTag: 81d76912-2d02-4296-986f-2354693e90cf

	measure 'Sålda enheter' = SUM('Försäljning'[Antal enheter])
		formatString: #,##0
		displayFolder: Ledningsöversikt
		lineageTag: 9fa7a019-90a5-472e-beab-9f9ad32b47cf

	measure Leveranser = [Antal order]
		formatString: #,##0
		displayFolder: Ledningsöversikt
		lineageTag: 61bcfa9f-51c1-4a54-8a92-a48149fbb03e

	measure 'Enheter föregående år' = CALCULATE([Sålda enheter], SAMEPERIODLASTYEAR('Datum'[Datum]))
		formatString: #,##0
		displayFolder: Ledningsöversikt
		lineageTag: 1b8f0bd2-5830-4133-b0ee-62eef8c9587d

	measure 'Bruttovinst föregående år' = CALCULATE([Bruttovinst], SAMEPERIODLASTYEAR('Datum'[Datum]))
		formatString: #,##0
		displayFolder: Ledningsöversikt
		lineageTag: 278c9e44-6506-4cd5-85dc-934f1a100fda

	measure 'Leveranser föregående år' = CALCULATE([Leveranser], SAMEPERIODLASTYEAR('Datum'[Datum]))
		formatString: #,##0
		displayFolder: Ledningsöversikt
		lineageTag: 418ace31-459d-41c4-aa23-67463667511f

	measure 'Enheter YoY' = DIVIDE([Sålda enheter] - [Enheter föregående år], [Enheter föregående år])
		formatString: +0.0 %;-0.0 %;0.0 %
		displayFolder: Ledningsöversikt
		lineageTag: 99bac03d-eac2-4757-8772-8021b928f248

	measure 'Bruttovinst YoY' = DIVIDE([Bruttovinst] - [Bruttovinst föregående år], [Bruttovinst föregående år])
		formatString: +0.0 %;-0.0 %;0.0 %
		displayFolder: Ledningsöversikt
		lineageTag: e07a86b7-1fb8-4375-8797-26b555bd4138

	measure 'Leveranser YoY' = DIVIDE([Leveranser] - [Leveranser föregående år], [Leveranser föregående år])
		formatString: +0.0 %;-0.0 %;0.0 %
		displayFolder: Ledningsöversikt
		lineageTag: 1c4f3b50-a291-4ebe-bec6-1a03e04f93a4

	measure 'Marginal föregående år' = CALCULATE([Bruttomarginal], SAMEPERIODLASTYEAR('Datum'[Datum]))
		formatString: 0.0 %
		displayFolder: Ledningsöversikt
		lineageTag: 246a7997-ccb4-45a8-bc96-04d43fb9f4a6

	measure 'Marginal förändring' = ([Bruttomarginal] - [Marginal föregående år]) * 100
		formatString: +0.0" pp";-0.0" pp";0.0" pp"
		displayFolder: Ledningsöversikt
		lineageTag: 28115ce9-ad9d-4999-8b6a-fe8f2ddf3fe1

	measure Trendvärde = IF(SELECTEDVALUE('Trendval'[Mått], "Omsättning") = "Bruttovinst", [Bruttovinst], [Omsättning])
		formatString: #,##0" kr"
		displayFolder: Ledningsöversikt
		lineageTag: 1b3b7bff-7051-488a-9bab-a5da65b61bf6

	measure 'Trend föregående år' = CALCULATE([Trendvärde], SAMEPERIODLASTYEAR('Datum'[Datum]))
		formatString: #,##0" kr"
		displayFolder: Ledningsöversikt
		lineageTag: 4567fbf3-bb06-4de8-9cb9-e74f6df872e8

	measure Produktvärde = IF(SELECTEDVALUE('Produktval'[Mått], "Omsättning") = "Sålda enheter", [Sålda enheter], [Omsättning])
		formatString: #,##0
		displayFolder: Ledningsöversikt
		lineageTag: 2328e12b-c25a-4795-a047-2ff15fc46623

	measure Analysvärde =
			VAR AxisName = SELECTEDVALUE('Analysaxel'[Namn])
			RETURN IF(SELECTEDVALUE('Analysaxel'[Typ], "Land") = "Land", CALCULATE([Omsättning], TREATAS({AxisName}, 'Kunder'[Land])), CALCULATE([Omsättning], TREATAS({AxisName}, 'Produkter'[Kategori])))
		formatString: #,##0" kr"
		displayFolder: Ledningsöversikt
		lineageTag: 1e7b38b5-8b48-4575-8708-470ad555c716

	measure 'Analys föregående år' = CALCULATE([Analysvärde], SAMEPERIODLASTYEAR('Datum'[Datum]))
		formatString: #,##0" kr"
		displayFolder: Ledningsöversikt
		lineageTag: 0ae7f6fb-a8c2-423c-97d0-27622a09154e

	measure 'Kostnad miljoner' = [Kostnad] / 1000000
		formatString: 0.0" mn kr"
		displayFolder: Ekonomi och lönsamhet
		lineageTag: 2db410e6-2d4b-408d-babe-03ad69e01dc7

	measure 'Omsättning per enhet' = DIVIDE([Omsättning], [Sålda enheter])
		formatString: #,##0.0" kr"
		displayFolder: Ekonomi och lönsamhet
		lineageTag: 3b32c57e-313b-4d87-9e8a-bcaf5d9d6ab2

	measure 'Bruttovinst per enhet' = DIVIDE([Bruttovinst], [Sålda enheter])
		formatString: #,##0.0" kr"
		displayFolder: Ekonomi och lönsamhet
		lineageTag: 03ebcef5-5294-45b9-8b76-4cd97cc4cdb7

	measure 'Aktiva säljare' = DISTINCTCOUNT('Försäljning'[Säljarnyckel])
		formatString: #,##0
		displayFolder: Försäljningsanalys
		lineageTag: 533b5543-1881-4a4b-9e7c-326711640d35

	measure 'Omsättning per säljare' = DIVIDE([Omsättning], [Aktiva säljare])
		formatString: #,##0" kr"
		displayFolder: Försäljningsanalys
		lineageTag: d63d5960-a64c-4d10-8751-88d73850f717

	measure 'Omsättning per säljare miljoner' = [Omsättning per säljare] / 1000000
		formatString: 0.0" mn kr"
		displayFolder: Försäljningsanalys
		lineageTag: 59715dc9-ad39-41b6-8936-7527eadcfc1e

	measure 'Genomsnittlig order' = DIVIDE([Omsättning], [Antal order])
		formatString: #,##0" kr"
		displayFolder: Försäljningsanalys
		lineageTag: 2377be3e-2ea1-4cf9-a6e1-52fcaa3bc79d

	measure 'Topp 5 säljare andel' =
			VAR SellerRevenue = ADDCOLUMNS(ALLSELECTED('Säljare'[Säljarnyckel]), "@Revenue", CALCULATE([Omsättning]))
			VAR BestSellers = TOPN(5, SellerRevenue, [@Revenue], DESC, 'Säljare'[Säljarnyckel], ASC)
			RETURN DIVIDE(SUMX(BestSellers, [@Revenue]), [Omsättning])
		formatString: 0.0 %
		displayFolder: Försäljningsanalys
		lineageTag: 90915574-6745-40c0-b5c9-f38fed8ceb59

	measure 'Kostnad föregående år' = CALCULATE([Kostnad], SAMEPERIODLASTYEAR('Datum'[Datum]))
		formatString: #,##0" kr"
		displayFolder: Ekonomi och lönsamhet
		lineageTag: 2edc8b00-b1b8-44d3-83e0-7ed524e14008

	measure 'Kostnad årsförändring' = DIVIDE([Kostnad] - [Kostnad föregående år], [Kostnad föregående år])
		formatString: +0.0 %;-0.0 %;0.0 %
		displayFolder: Ekonomi och lönsamhet
		lineageTag: 25d1de0b-280f-4170-8c66-53ab797e6fb3

	measure 'Omsättning per enhet föregående år' = CALCULATE([Omsättning per enhet], SAMEPERIODLASTYEAR('Datum'[Datum]))
		formatString: #,##0" kr"
		displayFolder: Ekonomi och lönsamhet
		lineageTag: 8a47030b-9e14-44fe-95fd-81f19807739c

	measure 'Omsättning per enhet årsförändring' = DIVIDE([Omsättning per enhet] - [Omsättning per enhet föregående år], [Omsättning per enhet föregående år])
		formatString: +0.0 %;-0.0 %;0.0 %
		displayFolder: Ekonomi och lönsamhet
		lineageTag: bc9b2cde-b9f7-4452-953a-6d8a239435c9

	measure 'Bruttovinst per enhet föregående år' = CALCULATE([Bruttovinst per enhet], SAMEPERIODLASTYEAR('Datum'[Datum]))
		formatString: #,##0" kr"
		displayFolder: Ekonomi och lönsamhet
		lineageTag: 098c4636-6909-4fc8-ad1f-0ca8f04a15f4

	measure 'Bruttovinst per enhet årsförändring' = DIVIDE([Bruttovinst per enhet] - [Bruttovinst per enhet föregående år], [Bruttovinst per enhet föregående år])
		formatString: +0.0 %;-0.0 %;0.0 %
		displayFolder: Ekonomi och lönsamhet
		lineageTag: 6291ca1e-ad50-43de-a4e8-11e80bbfa3eb

	measure 'Aktiva säljare föregående år' = CALCULATE([Aktiva säljare], SAMEPERIODLASTYEAR('Datum'[Datum]))
		formatString: #,##0
		displayFolder: Försäljningsanalys
		lineageTag: 58ea8d88-7a23-462e-884c-437f3912725c

	measure 'Aktiva säljare årsförändring' = DIVIDE([Aktiva säljare] - [Aktiva säljare föregående år], [Aktiva säljare föregående år])
		formatString: +0.0 %;-0.0 %;0.0 %
		displayFolder: Försäljningsanalys
		lineageTag: 9dfaf9df-e9ba-40bd-bc35-4a0afce05005

	measure 'Omsättning per säljare föregående år' = CALCULATE([Omsättning per säljare], SAMEPERIODLASTYEAR('Datum'[Datum]))
		formatString: #,##0" kr"
		displayFolder: Försäljningsanalys
		lineageTag: afe7bb2e-4f6a-4ae5-aa29-72dc1944d15a

	measure 'Omsättning per säljare årsförändring' = DIVIDE([Omsättning per säljare] - [Omsättning per säljare föregående år], [Omsättning per säljare föregående år])
		formatString: +0.0 %;-0.0 %;0.0 %
		displayFolder: Försäljningsanalys
		lineageTag: 6c50671c-9b5c-42a7-a489-c186c9140c86

	measure 'Genomsnittlig order föregående år' = CALCULATE([Genomsnittlig order], SAMEPERIODLASTYEAR('Datum'[Datum]))
		formatString: #,##0" kr"
		displayFolder: Försäljningsanalys
		lineageTag: f4e939f7-cea0-4d54-8793-5d97508c89f7

	measure 'Genomsnittlig order årsförändring' = DIVIDE([Genomsnittlig order] - [Genomsnittlig order föregående år], [Genomsnittlig order föregående år])
		formatString: +0.0 %;-0.0 %;0.0 %
		displayFolder: Försäljningsanalys
		lineageTag: 6ea269c0-5a9e-4fb3-a461-4ccaa09241b8

	measure 'Topp 5 säljare andel föregående år' = CALCULATE([Topp 5 säljare andel], SAMEPERIODLASTYEAR('Datum'[Datum]))
		formatString: 0.0 %
		displayFolder: Försäljningsanalys
		lineageTag: 9971327f-a5f5-46ef-a44c-6a2e8aab91ce

	measure 'Topp 5 andel förändring' = IF(ISBLANK([Topp 5 säljare andel föregående år]), BLANK(), ([Topp 5 säljare andel] - [Topp 5 säljare andel föregående år]) * 100)
		formatString: +0.0" pp";-0.0" pp";0.0" pp"
		displayFolder: Försäljningsanalys
		lineageTag: 72e7e083-3ea9-4a80-886c-616302a9059c

	measure 'Bruttovinst analys' =
			VAR AxisName = SELECTEDVALUE('Finansaxel'[Namn])
			RETURN IF(SELECTEDVALUE('Finansaxel'[Typ], "Säljteam") = "Kategori", CALCULATE([Bruttovinst], TREATAS({AxisName}, 'Produkter'[Kategori])), CALCULATE([Bruttovinst], TREATAS({AxisName}, 'Säljare'[Team])))
		formatString: #,##0" kr"
		displayFolder: Ekonomi och lönsamhet
		lineageTag: 1111d8e6-999e-4e76-8517-0f4a73436334

	measure 'Bruttovinst analys miljoner' = [Bruttovinst analys] / 1000000
		formatString: 0.0" mn kr"
		displayFolder: Ekonomi och lönsamhet
		lineageTag: 47bf6b77-836a-441c-acc9-b0e63525e7d6

	measure 'Månadsmedel bruttovinst' = AVERAGEX(ALLSELECTED('Datum'[Månad]), [Bruttovinst analys miljoner])
		formatString: 0.0" mn kr"
		displayFolder: Ekonomi och lönsamhet
		lineageTag: 0be792ac-3b08-4058-8867-bfad8aa1d092

	measure 'Bruttovinst andel land' = DIVIDE([Bruttovinst], CALCULATE([Bruttovinst], ALLSELECTED('Kunder'[Land])))
		formatString: 0.0 %
		displayFolder: Ekonomi och lönsamhet
		lineageTag: 0572d944-fa82-4a3c-9332-f3a27308e4b3

	measure 'Omsättning andel land' = DIVIDE([Omsättning], CALCULATE([Omsättning], ALLSELECTED('Kunder'[Land])))
		formatString: 0.0 %
		displayFolder: Försäljningsanalys
		lineageTag: e72020ee-1b88-481f-8aca-8b54935b6fb0

	measure 'Analys årsförändring' = DIVIDE([Analysvärde] - [Analys föregående år], [Analys föregående år])
		formatString: +0.0 %;-0.0 %;0.0 %
		displayFolder: Ledningsöversikt
		lineageTag: 13e80e22-e1e7-4e98-a04f-939647fac92f

	measure 'Marknadsbelopp etikett' = FORMAT([Analysvärde] / 1000000, "0.00", "sv-SE") & " mn kr"
		formatString: @
		displayFolder: Ledningsöversikt
		lineageTag: 21d16359-003c-4d13-bb07-9b1d11f82dc5

	measure 'Omsättning etikett' = FORMAT([Omsättning] / 1000000, "0.00", "sv-SE") & " mn kr"
		formatString: @
		displayFolder: Ledningsöversikt
		lineageTag: a7cec915-d403-4951-91da-3c5f72a25d64

	measure 'Produktvärde etikett' = IF(SELECTEDVALUE('Produktval'[Mått], "Omsättning") = "Sålda enheter", FORMAT([Produktvärde], "#,##0", "sv-SE") & " st", FORMAT([Produktvärde] / 1000000, "0.00", "sv-SE") & " mn kr")
		formatString: @
		displayFolder: Ledningsöversikt
		lineageTag: a0e09c8d-439d-4fce-b376-f1b859f3e69d

	measure 'Säljartopp 1 namn' =
			VAR _pool = FILTER(ADDCOLUMNS(ALLSELECTED('Säljare'), "__sales", CALCULATE([Omsättning])), [__sales] > 0)
			VAR _seller = TOPN(1, TOPN(1, _pool, [__sales], DESC, 'Säljare'[Säljarnyckel], ASC), [__sales], ASC, 'Säljare'[Säljarnyckel], DESC)
			VAR _enough = COUNTROWS(_pool) >= 1
			RETURN IF(_enough, MAXX(_seller, 'Säljare'[Säljare]))
		formatString: @
		isHidden
		displayFolder: Ledningsöversikt\Säljartopp
		lineageTag: b788d9b9-90e4-43e8-be09-b588591efc16

	measure 'Säljartopp 1 belopp' =
			VAR _pool = FILTER(ADDCOLUMNS(ALLSELECTED('Säljare'), "__sales", CALCULATE([Omsättning])), [__sales] > 0)
			VAR _seller = TOPN(1, TOPN(1, _pool, [__sales], DESC, 'Säljare'[Säljarnyckel], ASC), [__sales], ASC, 'Säljare'[Säljarnyckel], DESC)
			VAR _enough = COUNTROWS(_pool) >= 1
			RETURN IF(_enough, SUMX(_seller, [__sales]))
		formatString: #,##0" kr"
		isHidden
		displayFolder: Ledningsöversikt\Säljartopp
		lineageTag: 8f630f3c-7fb6-4fd9-a8e4-88a56e680027

	measure 'Säljartopp 1 förändring' =
			VAR _pool = FILTER(ADDCOLUMNS(ALLSELECTED('Säljare'), "__sales", CALCULATE([Omsättning])), [__sales] > 0)
			VAR _seller = TOPN(1, TOPN(1, _pool, [__sales], DESC, 'Säljare'[Säljarnyckel], ASC), [__sales], ASC, 'Säljare'[Säljarnyckel], DESC)
			VAR _enough = COUNTROWS(_pool) >= 1
			VAR _sales = SUMX(_seller, [__sales])
			VAR _prior = SUMX(_seller, CALCULATE([Omsättning föregående år]))
			RETURN IF(_enough, DIVIDE(_sales - _prior, _prior))
		formatString: +0.0 %;-0.0 %;0.0 %
		isHidden
		displayFolder: Ledningsöversikt\Säljartopp
		lineageTag: 5e919919-1fdb-4f29-92ed-4619a19f42d7

	measure 'Säljartopp 1 initialer' =
			VAR _name = [Säljartopp 1 namn]
			RETURN IF(NOT ISBLANK(_name), LEFT(_name, 1) & MID(_name, SEARCH(" ", _name, 1, LEN(_name)) + 1, 1))
		formatString: @
		isHidden
		displayFolder: Ledningsöversikt\Säljartopp
		lineageTag: be8abcf6-c81b-404e-87c1-91491880eac5

	measure 'Säljartopp 1 etikett' =
			VAR _value = [Säljartopp 1 belopp]
			RETURN IF(NOT ISBLANK(_value), FORMAT(_value / 1000000, "0.00", "sv-SE") & " mn kr")
		formatString: @
		isHidden
		displayFolder: Ledningsöversikt\Säljartopp
		lineageTag: 880a8dd0-9107-4928-8f23-93b8e077a4fc

	measure 'Säljartopp 1 segment' =
			VAR _value = [Säljartopp 1 belopp]
			RETURN IF(NOT ISBLANK(_value), REPT(UNICHAR(9648), MAX(1, ROUNDUP(18 * DIVIDE(_value, [Säljartopp 1 belopp]), 0))))
		formatString: @
		isHidden
		displayFolder: Ledningsöversikt\Säljartopp
		lineageTag: 3c3e84a4-dc4a-4953-b11c-effcbd66fb1f

	measure 'Säljartopp 2 namn' =
			VAR _pool = FILTER(ADDCOLUMNS(ALLSELECTED('Säljare'), "__sales", CALCULATE([Omsättning])), [__sales] > 0)
			VAR _seller = TOPN(1, TOPN(2, _pool, [__sales], DESC, 'Säljare'[Säljarnyckel], ASC), [__sales], ASC, 'Säljare'[Säljarnyckel], DESC)
			VAR _enough = COUNTROWS(_pool) >= 2
			RETURN IF(_enough, MAXX(_seller, 'Säljare'[Säljare]))
		formatString: @
		isHidden
		displayFolder: Ledningsöversikt\Säljartopp
		lineageTag: 9b4b4446-f15e-4c0c-9a5c-3192d193a835

	measure 'Säljartopp 2 belopp' =
			VAR _pool = FILTER(ADDCOLUMNS(ALLSELECTED('Säljare'), "__sales", CALCULATE([Omsättning])), [__sales] > 0)
			VAR _seller = TOPN(1, TOPN(2, _pool, [__sales], DESC, 'Säljare'[Säljarnyckel], ASC), [__sales], ASC, 'Säljare'[Säljarnyckel], DESC)
			VAR _enough = COUNTROWS(_pool) >= 2
			RETURN IF(_enough, SUMX(_seller, [__sales]))
		formatString: #,##0" kr"
		isHidden
		displayFolder: Ledningsöversikt\Säljartopp
		lineageTag: 33fe3b70-a732-491e-ab69-003e72bedb51

	measure 'Säljartopp 2 förändring' =
			VAR _pool = FILTER(ADDCOLUMNS(ALLSELECTED('Säljare'), "__sales", CALCULATE([Omsättning])), [__sales] > 0)
			VAR _seller = TOPN(1, TOPN(2, _pool, [__sales], DESC, 'Säljare'[Säljarnyckel], ASC), [__sales], ASC, 'Säljare'[Säljarnyckel], DESC)
			VAR _enough = COUNTROWS(_pool) >= 2
			VAR _sales = SUMX(_seller, [__sales])
			VAR _prior = SUMX(_seller, CALCULATE([Omsättning föregående år]))
			RETURN IF(_enough, DIVIDE(_sales - _prior, _prior))
