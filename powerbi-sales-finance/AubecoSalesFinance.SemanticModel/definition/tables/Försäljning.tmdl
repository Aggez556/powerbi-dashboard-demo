		displayFolder: Ekonomi och lönsamhet\Presentation
		lineageTag: 7ad8f9d0-b9a7-4f67-af32-55cb9335ce78

	measure 'Finans marknadstrend' =
			VAR _months = ADDCOLUMNS(ALLSELECTED('Datum'[Månadsnummer]), "__value", CALCULATE([Bruttovinst]))
			VAR _low = MINX(_months, [__value])
			VAR _high = MAXX(_months, [__value])
			VAR _points = CONCATENATEX(_months, FORMAT(4 + ('Datum'[Månadsnummer] - 1) * 8, "0", "en-US") & "," & FORMAT(23 - 18 * DIVIDE([__value] - _low, _high - _low, 0.5), "0", "en-US"), " ", 'Datum'[Månadsnummer], ASC)
			RETURN IF(NOT ISBLANK([Bruttovinst]), "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 96 28'><polyline fill='none' stroke='rgb(15,49,99)' stroke-width='1.5' points='" & _points & "'/></svg>")
		formatString: @
		isHidden
		displayFolder: Ekonomi och lönsamhet\Presentation
		lineageTag: 3b3af416-7c05-4db5-8a49-4f8dc535aa2c
		dataCategory: ImageUrl

