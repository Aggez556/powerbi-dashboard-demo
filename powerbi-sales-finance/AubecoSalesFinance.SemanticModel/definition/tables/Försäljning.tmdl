	measure 'Finans sammanställning marginalbild' =
			VAR _margin = [Finans sammanställning marginal]
			VAR _portion = MIN(1, MAX(0, ABS(_margin)))
			VAR _angle = _portion * 2 * PI()
			VAR _x = FORMAT(12 + 7 * SIN(_angle), "0.00", "en-US")
			VAR _y = FORMAT(14 - 7 * COS(_angle), "0.00", "en-US")
			VAR _ink = IF(_margin < 0, "rgb(184,50,50)", "rgb(15,49,99)")
			RETURN IF(NOT ISBLANK(_margin), "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 96 28'><circle cx='12' cy='14' r='7' fill='rgb(231,237,245)'/><path d='M12,14 L12,7 A7,7 0 " & IF(_portion > 0.5, "1", "0") & " 1 " & _x & "," & _y & " Z' fill='" & _ink & "'/><text x='25' y='18' font-family='Segoe UI,Arial' font-size='12' fill='rgb(15,49,99)'>" & FORMAT(_margin, "0.0 %", "sv-SE") & "</text></svg>")
		formatString: @
		isHidden
		displayFolder: Ekonomi och lönsamhet\Presentation
		lineageTag: ea0461da-f0a9-41c0-b263-89dffaadea91
		dataCategory: ImageUrl

	measure 'Finans sammanställning trend' =
			VAR _months = ADDCOLUMNS(ALLSELECTED('Datum'[Månadsnummer]), "__value", CALCULATE([Finans sammanställning vinst]))
			VAR _low = MINX(_months, [__value])
			VAR _high = MAXX(_months, [__value])
			VAR _points = CONCATENATEX(_months, FORMAT(4 + ('Datum'[Månadsnummer] - 1) * 8, "0", "en-US") & "," & FORMAT(23 - 18 * DIVIDE([__value] - _low, _high - _low, 0.5), "0", "en-US"), " ", 'Datum'[Månadsnummer], ASC)
			VAR _last = TOPN(1, _months, 'Datum'[Månadsnummer], DESC)
			VAR _lastX = FORMAT(MAXX(_last, 4 + ('Datum'[Månadsnummer] - 1) * 8), "0", "en-US")
			VAR _lastY = FORMAT(MAXX(_last, 23 - 18 * DIVIDE([__value] - _low, _high - _low, 0.5)), "0", "en-US")
			RETURN IF(NOT ISBLANK([Finans sammanställning vinst]), "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 96 28'><polyline fill='none' stroke='rgb(15,49,99)' stroke-width='1.3' points='" & _points & "'/><circle cx='" & _lastX & "' cy='" & _lastY & "' r='1.8' fill='rgb(15,49,99)'/></svg>")
		formatString: @
		isHidden
		displayFolder: Ekonomi och lönsamhet\Presentation
		lineageTag: dadc78f6-864a-46ca-98bb-de4505d236dc
		dataCategory: ImageUrl

