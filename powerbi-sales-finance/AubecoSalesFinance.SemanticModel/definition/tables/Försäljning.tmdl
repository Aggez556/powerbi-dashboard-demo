	partition Försäljning = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "/FactSales.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Headers, {{"SellerKey", Int64.Type}, {"SalesLineKey", Int64.Type}, {"OrderKey", Int64.Type}, {"DateKey", Int64.Type}, {"CustomerKey", Int64.Type}, {"ProductKey", Int64.Type}, {"Quantity", Int64.Type}, {"UnitPrice", Currency.Type}, {"UnitCost", Currency.Type}, {"Revenue", Currency.Type}, {"Cost", Currency.Type}}, "en-US")
				in
					Typed

