	measure 'Finans marknad 1 etikett' =
			VAR _pool = FILTER(ADDCOLUMNS(ALLSELECTED('Kunder'[Land]), "__profit", CALCULATE([Bruttovinst])), NOT ISBLANK([__profit]))
			VAR _row = TOPN(1, TOPN(1, _pool, [__profit], DESC, 'Kunder'[Land], ASC), [__profit], ASC, 'Kunder'[Land], DESC)
			VAR _enough = COUNTROWS(_pool) >= 1
			VAR _profit = SUMX(_row, [__profit])
			VAR _share = DIVIDE(_profit, [Bruttovinst])
			RETURN IF(_enough, MAXX(_row, 'Kunder'[Land]) & " | " & FORMAT(_profit / 1000000, "0.00", "sv-SE") & " mn kr (" & FORMAT(_share, "0.0 %", "sv-SE") & ")")
		formatString: @
		isHidden
		displayFolder: Ekonomi och lönsamhet\Presentation
		lineageTag: 8ae3430b-c2ec-4218-beea-30d03e231f11

