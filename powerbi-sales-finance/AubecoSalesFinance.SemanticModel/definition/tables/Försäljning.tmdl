	measure 'Finans månadsmedel' =
			VAR _dates = ALLSELECTED('Datum')
			VAR _months = SUMMARIZE(_dates, 'Datum'[År], 'Datum'[Månadsnummer])
			RETURN AVERAGEX(_months, VAR _year = 'Datum'[År] VAR _month = 'Datum'[Månadsnummer]
			RETURN CALCULATE([Finans gruppvinst miljoner], REMOVEFILTERS('Datum'), _dates, TREATAS({_year}, 'Datum'[År]), TREATAS({_month}, 'Datum'[Månadsnummer])))
