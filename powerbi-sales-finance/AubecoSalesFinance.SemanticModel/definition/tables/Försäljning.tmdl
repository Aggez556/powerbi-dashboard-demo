	measure 'Säljanalys trend 1 namn' =
			VAR _dates = ALLSELECTED('Datum')
			VAR _pool = FILTER(ADDCOLUMNS(ALLSELECTED('Analysaxel'[Område]), "__value", CALCULATE([Säljanalys gruppomsättning], REMOVEFILTERS('Datum'), _dates)), [__value] > 0)
			VAR _chosen = TOPN(1, TOPN(1, _pool, [__value], DESC, 'Analysaxel'[Område], ASC), [__value], ASC, 'Analysaxel'[Område], DESC)
			VAR _name = MAXX(_chosen, 'Analysaxel'[Område])
			VAR _enough = COUNTROWS(_pool) >= 1
			RETURN IF(_enough, _name)
		formatString: @
		isHidden
		displayFolder: Försäljningsanalys\Presentation
		lineageTag: 13feab78-12d4-471a-aab3-c890439f1255

	measure 'Säljanalys trend 1 värde' =
			VAR _dates = ALLSELECTED('Datum')
