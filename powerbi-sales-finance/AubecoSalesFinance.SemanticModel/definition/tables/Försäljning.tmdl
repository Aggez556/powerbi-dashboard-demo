			VAR _months = SUMMARIZE(ALLSELECTED('Datum'), 'Datum'[År], 'Datum'[Månadsnummer])
			RETURN MAXX(CROSSJOIN(_groups, _months), CALCULATE([Finans gruppvinst miljoner], REMOVEFILTERS('Finansaxel'[Panel]), REMOVEFILTERS('Finansaxel'[Namn]))) * 1.15
