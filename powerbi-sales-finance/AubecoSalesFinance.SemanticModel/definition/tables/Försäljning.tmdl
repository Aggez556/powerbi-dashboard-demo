			RETURN IF(NOT ISBLANK(_share), "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 96 28'><circle cx='9' cy='14' r='5' fill='rgb(231,237,245)'/><circle cx='9' cy='14' r='2.5' fill='none' stroke='rgb(15,49,99)' stroke-width='5' stroke-dasharray='15.708' stroke-dashoffset='" & FORMAT(15.708 * (1 - _bounded), "0.00", "en-US") & "' transform='rotate(-90 9 14)'/><text x='21' y='18' font-family='Segoe UI' font-size='16' fill='rgb(15,49,99)'>" & FORMAT(_share, "0.0 %", "sv-SE") & "</text></svg>")
		formatString: @
