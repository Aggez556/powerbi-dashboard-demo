table Analysaxel
	lineageTag: 874b5729-326d-4794-8d21-222b6b0b20cd

	column Typ
		dataType: string
		lineageTag: b6c72134-59f6-4d63-a5da-d8489882ef4f
		summarizeBy: none
		sourceColumn: Type

	column Namn
		dataType: string
		lineageTag: e4402f7f-cfb7-4369-b41c-e03b15b293db
		summarizeBy: none
		sourceColumn: Name

	column Område = IF('Analysaxel'[Typ] = "Kategori" && NOT('Analysaxel'[Namn] IN {"Elektronik", "Hem och kök"}), "Övrigt", 'Analysaxel'[Namn])
		dataType: string
		lineageTag: 0442d35e-745f-4889-8547-ef66bbe4b1f9
		summarizeBy: none

	partition Analysaxel = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "/Analysaxel.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Headers, {{"Type", type text}, {"Name", type text}}, "en-US")
				in
					Typed

