EVALUATE
UNION(
CALCULATETABLE(ROW("Kontext", "Helår", "Rader", COUNTROWS('Försäljning'), "Omsättning", [Omsättning], "Kostnad", [Kostnad], "Bruttovinst", [Bruttovinst], "Marginal", [Bruttomarginal], "Antal", [Sålda enheter], "Leveranser", [Leveranser], "Negativa rader", COUNTROWS(FILTER('Försäljning', 'Försäljning'[Radomsättning] < 'Försäljning'[Radkostnad]))), TREATAS({2025}, 'Datum'[År])),
CALCULATETABLE(ROW("Kontext", "Oktober", "Rader", COUNTROWS('Försäljning'), "Omsättning", [Omsättning], "Kostnad", [Kostnad], "Bruttovinst", [Bruttovinst], "Marginal", [Bruttomarginal], "Antal", [Sålda enheter], "Leveranser", [Leveranser], "Negativa rader", COUNTROWS(FILTER('Försäljning', 'Försäljning'[Radomsättning] < 'Försäljning'[Radkostnad]))), TREATAS({2025}, 'Datum'[År]), TREATAS({10}, 'Datum'[Månadsnummer])),
CALCULATETABLE(ROW("Kontext", "Flera månader", "Rader", COUNTROWS('Försäljning'), "Omsättning", [Omsättning], "Kostnad", [Kostnad], "Bruttovinst", [Bruttovinst], "Marginal", [Bruttomarginal], "Antal", [Sålda enheter], "Leveranser", [Leveranser], "Negativa rader", COUNTROWS(FILTER('Försäljning', 'Försäljning'[Radomsättning] < 'Försäljning'[Radkostnad]))), TREATAS({2025}, 'Datum'[År]), TREATAS({1,2,3}, 'Datum'[Månadsnummer])),
CALCULATETABLE(ROW("Kontext", "Marknad", "Rader", COUNTROWS('Försäljning'), "Omsättning", [Omsättning], "Kostnad", [Kostnad], "Bruttovinst", [Bruttovinst], "Marginal", [Bruttomarginal], "Antal", [Sålda enheter], "Leveranser", [Leveranser], "Negativa rader", COUNTROWS(FILTER('Försäljning', 'Försäljning'[Radomsättning] < 'Försäljning'[Radkostnad]))), TREATAS({2025}, 'Datum'[År]), TREATAS({10}, 'Datum'[Månadsnummer]), TREATAS({"Norge"}, 'Kunder'[Land])),
CALCULATETABLE(ROW("Kontext", "Produktsökning", "Rader", COUNTROWS('Försäljning'), "Omsättning", [Omsättning], "Kostnad", [Kostnad], "Bruttovinst", [Bruttovinst], "Marginal", [Bruttomarginal], "Antal", [Sålda enheter], "Leveranser", [Leveranser], "Negativa rader", COUNTROWS(FILTER('Försäljning', 'Försäljning'[Radomsättning] < 'Försäljning'[Radkostnad]))), TREATAS({2025}, 'Datum'[År]), FILTER(ALL('Produkter'[Produkt]), CONTAINSSTRING('Produkter'[Produkt], "hantel"))),
CALCULATETABLE(ROW("Kontext", "Tomt", "Rader", COUNTROWS('Försäljning'), "Omsättning", [Omsättning], "Kostnad", [Kostnad], "Bruttovinst", [Bruttovinst], "Marginal", [Bruttomarginal], "Antal", [Sålda enheter], "Leveranser", [Leveranser], "Negativa rader", COUNTROWS(FILTER('Försäljning', 'Försäljning'[Radomsättning] < 'Försäljning'[Radkostnad]))), TREATAS({2025}, 'Datum'[År]), TREATAS({"Finns inte"}, 'Produkter'[Produkt]))
)
ORDER BY [Kontext]
