/// Reproducerbar lokal demodata; Kunder.csv.
table Kunder
	lineageTag: 4d3758bb-34a3-411e-9c2e-bff6a08db726

	/// Källfält i lokal demodata: Kunder.Kundnyckel.
	column Kundnyckel
		dataType: int64
		isHidden
		lineageTag: 664ec81b-87cf-46d2-a9b7-c799220d21fc
		summarizeBy: none
		sourceColumn: Kundnyckel

	/// Källfält i lokal demodata: Kunder.Kund.
	column Kund
		dataType: string
		lineageTag: 628ebc22-af4a-4c0b-8c2e-72c46ede2faf
		summarizeBy: none
		sourceColumn: Kund

	/// Källfält i lokal demodata: Kunder.Ort.
	column Ort
		dataType: string
		lineageTag: b9d98fdf-c30e-45d7-a8fb-2b56de14734e
		summarizeBy: none
		sourceColumn: Ort

	partition Kunder = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "/Kunder.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Headers, {{"Kundnyckel", Int64.Type}, {"Kund", type text}, {"Ort", type text}}, "en-US")
				in
					Typed

