{
  "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/main/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.157.json",
  "name": "LedningsrapportTheme.json",
  "dataColors": [
    "#0F3163",
    "#007956",
    "#4A6BCE",
    "#9B570B",
    "#5B6B80"
  ],
  "good": "#007956",
  "neutral": "#946200",
  "bad": "#B42318",
  "maximum": "#0F3163",
  "center": "#FBD6A8",
  "minimum": "#FDF6EC",
  "null": "#5B6B80",
  "textClasses": {
    "callout": {
      "fontSize": 32,
      "fontFace": "Segoe UI Semibold",
      "color": "#0F3163"
    },
    "title": {
      "fontSize": 20,
      "fontFace": "Segoe UI Semibold",
      "color": "#0F3163"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#0B1B30"
    },
    "label": {
      "fontSize": 11,
      "fontFace": "Segoe UI",
      "color": "#5B6B80"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#D5DDE7"
              }
            },
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 8,
            "bottom": 8,
            "left": 8,
            "right": 8
          }
        ],
        "categoryAxis": [
          {
            "gridlineStyle": "dotted",
            "gridlineColor": {
              "solid": {
                "color": "#D5DDE7"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "gridlineStyle": "dotted",
            "gridlineColor": {
              "solid": {
                "color": "#D5DDE7"
              }
            }
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "title": [
          {
            "show": true,
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 14,
            "fontColor": {
              "solid": {
                "color": "#0F3163"
              }
            }
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "autoSizeColumnWidth": true,
            "columnAdjustment": "growToFit",
            "backColor": {
              "solid": {
                "color": "#FDF6EC"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#0B1B30"
              }
            },
            "bold": true
          }
        ],
        "values": [
          {
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#FDF6EC"
              }
            },
            "fontColorPrimary": {
              "solid": {
                "color": "#0B1B30"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#0B1B30"
              }
            }
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "autoSizeColumnWidth": true,
            "columnAdjustment": "growToFit",
            "backColor": {
              "solid": {
                "color": "#FDF6EC"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#0B1B30"
              }
            },
            "bold": true
          }
        ],
        "values": [
          {
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#FDF6EC"
              }
            },
            "fontColorPrimary": {
              "solid": {
                "color": "#0B1B30"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#0B1B30"
              }
            }
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "value": [
          {
            "bold": true,
            "$id": "default",
            "fontSize": 32,
            "fontFamily": "Segoe UI Semibold",
            "fontColor": {
              "solid": {
                "color": "#0F3163"
              }
            }
          }
        ],
        "label": [
          {
            "show": true,
            "$id": "default",
            "fontSize": 11,
            "fontFamily": "Segoe UI",
            "fontColor": {
              "solid": {
                "color": "#5B6B80"
              }
            }
          }
        ],
        "cardCalloutArea": [
          {
            "paddingUniform": 0
          }
        ],
        "title": [
          {
            "show": false
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "padding": [
          {
            "top": 0,
            "bottom": 0,
            "left": 0,
            "right": 0
          }
        ],
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "barChart": {
      "*": {
        "labels": [
          {
            "show": true,
            "fontSize": 11
          }
        ],
        "valueAxis": [
          {
            "show": false,
            "gridlineShow": false,
            "showAxisTitle": false
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "fontSize": 11,
            "labelColor": {
              "solid": {
                "color": "#5B6B80"
              }
            },
            "showAxisTitle": false,
            "innerPadding": 20,
            "gridlineShow": false
          }
        ],
        "dataPoint": [
          {
            "borderShow": false
          }
        ],
        "legend": [
          {
            "show": false
          }
        ]
      }
    },
    "clusteredBarChart": {
      "*": {
        "labels": [
          {
            "show": true,
            "fontSize": 11
          }
        ],
        "valueAxis": [
          {
            "show": false,
            "gridlineShow": false,
            "showAxisTitle": false
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "fontSize": 11,
            "labelColor": {
              "solid": {
                "color": "#5B6B80"
              }
            },
            "showAxisTitle": false,
            "innerPadding": 20,
            "gridlineShow": false
          }
        ],
        "dataPoint": [
          {
            "borderShow": false
          }
        ],
        "legend": [
          {
            "show": true,
            "fontSize": 11,
            "labelColor": {
              "solid": {
                "color": "#5B6B80"
              }
            }
          }
        ]
      }
    },
    "columnChart": {
      "*": {
        "labels": [
          {
            "show": true,
            "fontSize": 11
          }
        ],
        "valueAxis": [
          {
            "show": false,
            "gridlineShow": false,
            "showAxisTitle": false
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "fontSize": 11,
            "labelColor": {
              "solid": {
                "color": "#5B6B80"
              }
            },
            "showAxisTitle": false,
            "innerPadding": 20,
            "gridlineShow": false
          }
        ],
        "dataPoint": [
          {
            "borderShow": false
          }
        ],
        "legend": [
          {
            "show": false
          }
        ]
      }
    },
    "clusteredColumnChart": {
      "*": {
        "labels": [
          {
            "show": true,
            "fontSize": 11
          }
        ],
        "valueAxis": [
          {
            "show": false,
            "gridlineShow": false,
            "showAxisTitle": false
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "fontSize": 11,
            "labelColor": {
              "solid": {
                "color": "#5B6B80"
              }
            },
            "showAxisTitle": false,
            "innerPadding": 20,
            "gridlineShow": false
          }
        ],
        "dataPoint": [
          {
            "borderShow": false
          }
        ],
        "legend": [
          {
            "show": true,
            "fontSize": 11,
            "labelColor": {
              "solid": {
                "color": "#5B6B80"
              }
            }
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [
          {
            "strokeWidth": 2.5,
            "lineChartType": "linear",
            "areaShow": false
          }
        ],
        "dataPoint": [
          {
            "transparency": 0
          }
        ],
        "labels": [
          {
            "show": true,
            "labelPosition": "Above",
            "fontSize": 11,
            "color": {
              "solid": {
                "color": "#0B1B30"
              }
            },
            "labelDensity": 25
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "fontSize": 11,
            "labelColor": {
              "solid": {
                "color": "#5B6B80"
              }
            },
            "showAxisTitle": false,
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "fontSize": 11,
            "labelColor": {
              "solid": {
                "color": "#5B6B80"
              }
            },
            "showAxisTitle": false,
            "gridlineStyle": "dotted",
            "gridlineColor": {
              "solid": {
                "color": "#D5DDE7"
              }
            }
          }
        ],
        "legend": [
          {
            "show": false
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "fontFamily": "Segoe UI Semibold",
            "textSize": 11,
            "fontColor": {
              "solid": {
                "color": "#0B1B30"
              }
            },
            "outlineStyle": 0
          }
        ],
        "items": [
          {
            "fontFamily": "Segoe UI",
            "textSize": 11,
            "fontColor": {
              "solid": {
                "color": "#0B1B30"
              }
            },
            "outlineStyle": 0,
            "padding": 6
          }
        ],
        "date": [
          {
            "fontFamily": "Segoe UI",
            "textSize": 11,
            "fontColor": {
              "solid": {
                "color": "#0B1B30"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#FDF6EC"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "fontSize": 32,
            "fontFamily": "Segoe UI Semibold",
            "color": {
              "solid": {
                "color": "#0F3163"
              }
            }
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "fontSize": 11,
            "fontFamily": "Segoe UI",
            "color": {
              "solid": {
                "color": "#5B6B80"
              }
            }
          }
        ],
        "title": [
          {
            "show": false
          }
        ]
      }
    }
  },
  "foreground": "#0B1B30",
  "firstLevelElements": "#0B1B30",
  "secondLevelElements": "#5B6B80",
  "thirdLevelElements": "#D5DDE7",
  "fourthLevelElements": "#5B6B80",
  "background": "#FFFFFF",
  "secondaryBackground": "#FDF6EC",
  "tableAccent": "#0F3163",
  "accent": "#F7BA6B"
}