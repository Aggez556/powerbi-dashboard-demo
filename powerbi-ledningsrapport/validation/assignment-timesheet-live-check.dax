EVALUATE
UNION(
 CALCULATETABLE(ROW("Period","Year 2025","Hours",[Utfall timmar],"Capacity",[Utfall kapacitet],"Rate",[Utfall debiteringsgrad]),TREATAS({"Helår"},'Periodtyp'[Periodtyp]),TREATAS({"2025"},'Helårsval'[Period])),
 CALCULATETABLE(ROW("Period","R12 Sep 2026","Hours",[Utfall timmar],"Capacity",[Utfall kapacitet],"Rate",[Utfall debiteringsgrad]),TREATAS({"R12"},'Periodtyp'[Periodtyp]),TREATAS({"September 2026"},'R12val'[Period])))
ORDER BY [Period]
