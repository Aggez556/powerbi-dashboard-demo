EVALUATE UNION(CALCULATETABLE(ROW("Case","R12 September 2026","Jobs",[Uppdrag utförda],"PreviousJobs",[Uppdrag utförda föregående],"Hours",[Utfall timmar],"Available",[Utfall kapacitet],"Margin",[Utfall marginal],"Booked",[Plan bokat],"Capacity",[Plan kapacitet],"Free",[Plan ledigt],"Over",[Plan överbeläggning]),TREATAS({"R12"},'Periodtyp'[Periodtyp]),TREATAS({"September 2026"},'R12val'[Period])),
