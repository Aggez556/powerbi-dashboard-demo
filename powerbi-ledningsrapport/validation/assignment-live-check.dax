EVALUATE CALCULATETABLE(SUMMARIZECOLUMNS('Resurser'[Resursgrupp],'Planveckor'[Vecka],"Booked",[Plan bokat],"Capacity",[Plan kapacitet],"Free",[Plan ledigt],"Over",[Plan överbeläggning],"Rate",[Plan beläggning]),TREATAS({"R12"},'Periodtyp'[Periodtyp]),TREATAS({"September 2026"},'R12val'[Period])) ORDER BY 'Resurser'[Resursgrupp],'Planveckor'[Vecka]

EVALUATE CALCULATETABLE(SUMMARIZECOLUMNS('Uppdragsregister'[UppdragID],'Uppdragsregister'[Uppdrag],"Visible",[Uppdrag synligt],"WholeHours",[Uppdrag hela timmar],"Risk",[Uppdrag risk],"Forecast",[Uppdrag prognos],"Customer",[Uppdrag kund]),TREATAS({"R12"},'Periodtyp'[Periodtyp]),TREATAS({"September 2026"},'R12val'[Period])) ORDER BY 'Uppdragsregister'[UppdragID]
