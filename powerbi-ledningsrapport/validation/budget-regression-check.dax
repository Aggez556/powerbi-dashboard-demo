EVALUATE
CALCULATETABLE(
 ROW("Revenue",[Budget omsättning huvud],"EBIT",[Budget resultat huvud],"Margin",[Budget marginal huvud]),
 TREATAS({2026},'Budgetår'[År]),TREATAS({1,2,3,4,5,6,7,8,9},'Budgetmånader'[Nummer]),TREATAS({1},'Budgetscenarion'[ScenarioID]),TREATAS({1},'Budgetjämförelse'[Ordning]))

EVALUATE
CALCULATETABLE(
 SUMMARIZECOLUMNS('Budgetrapportnoder'[NodID],'Budgetrapportnoder'[Etikett],'Budgetrapportnoder'[Förälder],'Budgetrapportnoder'[Överförälder],'Budgetrapportnoder'[Nivå],'Budgetrapportnoder'[Typ],'Budgetrapportnoder'[Ordning],'Budgetrapportnoder'[HarBarn],'Budgetrapportnoder'[Avsnitt],'Budgetkolumner'[Grupp],'Budgetkolumner'[MånadID],'Budgetkolumner'[Kolumn],'Budgetkolumner'[Position],"Amount",[Rapportvärde],"Text",[Rapporttext],"Color",[Rapportfärg]),
 TREATAS({2026},'Budgetår'[År]),TREATAS({1,2,3,4,5,6,7,8,9},'Budgetmånader'[Nummer]),TREATAS({1},'Budgetscenarion'[ScenarioID]),TREATAS({1},'Budgetjämförelse'[Ordning]))
ORDER BY 'Budgetrapportnoder'[Ordning],'Budgetkolumner'[MånadID],'Budgetkolumner'[Position]
