{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "Interaktiv resultaträkning. Kontogrupper kan expanderas; beräknade rader är blad utan pilar.",
  "width": 1252,
  "height": 572,
  "padding": 0,
  "autosize": {
    "type": "none",
    "contains": "padding"
  },
  "background": "#FFFFFF",
  "signals": [
    {
      "name": "rowHeight",
      "value": 36
    },
    {
      "name": "headerH",
      "value": 80
    },
    {
      "name": "labelW",
      "value": 300
    },
    {
      "name": "columnW",
      "update": "max(length(data('columns')) && indexof(data('columns')[0].Metric,' · ')>=0?168:144,(width-labelW-12)/max(1,length(data('columns'))))"
    },
    {
      "name": "budgetW",
      "update": "length(data('columns')) && data('columns')[0].Metric==='Föregående år'?120:length(data('columns')) && indexof(data('columns')[0].Metric,' · ')>=0?128:88"
    },
    {
      "name": "bodyW",
      "update": "max(20,width-labelW-12)"
    },
    {
      "name": "fullW",
      "update": "length(data('columns'))/2*(columnW+budgetW)"
    },
    {
      "name": "maxX",
      "update": "fullW>bodyW+0.5?fullW-bodyW:0"
    },
    {
      "name": "bodyH",
      "update": "height-headerH-(maxX>0?12:0)"
    },
    {
      "name": "fullH",
      "update": "length(data('rows'))?data('rows')[length(data('rows'))-1].RowTop+rowHeight:0"
    },
    {
      "name": "maxY",
      "update": "max(0,fullH-bodyH)"
    },
    {
      "name": "clickedNode",
      "value": null,
      "on": [
        {
          "events": "@nodeHit:click",
          "update": "datum.Children===1?datum.Node:null",
          "force": true
        }
      ]
    },
    {
      "name": "expandAll",
      "value": 0,
      "on": [
        {
          "events": "@expandAllButton:click",
          "update": "now()",
          "force": true
        }
      ]
    },
    {
      "name": "collapseAll",
      "value": 0,
      "on": [
        {
          "events": "@collapseAllButton:click",
          "update": "now()",
          "force": true
        }
      ]
    },
    {
      "name": "hoverNode",
      "value": null,
      "on": [
        {
          "events": "@nodeHit:mouseover",
          "update": "datum.Node"
        },
        {
          "events": "@nodeHit:mouseout",
          "update": "null"
        }
      ]
    },
    {
      "name": "hDrag",
      "value": null,
      "on": [
        {
          "events": "@hthumb:mousedown",
          "update": "{x:x(),start:scrollX}"
        },
        {
          "events": "window:mouseup",
          "update": "null"
        }
      ]
    },
    {
      "name": "vDrag",
      "value": null,
      "on": [
        {
          "events": "@vthumb:mousedown",
          "update": "{y:y(),start:scrollY}"
        },
        {
          "events": "window:mouseup",
          "update": "null"
        }
      ]
    },
    {
      "name": "scrollX",
      "value": 0,
      "on": [
        {
          "events": {
            "type": "wheel",
            "consume": true
          },
          "update": "clamp(scrollX+(event.shiftKey?event.deltaY:event.deltaX),0,maxX)"
        },
        {
          "events": "window:mousemove",
          "update": "hDrag?clamp(hDrag.start+(x()-hDrag.x)*fullW/bodyW,0,maxX):scrollX"
        },
        {
          "events": {
            "signal": "maxX"
          },
          "update": "clamp(scrollX,0,maxX)"
        }
      ]
    },
    {
      "name": "scrollY",
      "value": 0,
      "on": [
        {
          "events": {
            "type": "wheel",
            "consume": true
          },
          "update": "clamp(scrollY+(event.shiftKey?0:event.deltaY),0,maxY)"
        },
        {
          "events": "window:mousemove",
          "update": "vDrag?clamp(vDrag.start+(y()-vDrag.y)*fullH/bodyH,0,maxY):scrollY"
        },
        {
          "events": {
            "signal": "maxY"
          },
          "update": "clamp(scrollY,0,maxY)"
        }
      ]
    }
  ],
  "data": [
    {
      "name": "dataset"
    },
    {
      "name": "open",
      "values": [
        {
          "key": "r6"
        },
        {
          "key": "r6_s2"
        }
      ],
      "on": [
        {
          "trigger": "clickedNode",
          "toggle": "{key:clickedNode}"
        },
        {
          "trigger": "expandAll",
          "remove": "true"
        },
        {
          "trigger": "expandAll",
          "insert": "data('expandables')"
        },
        {
          "trigger": "collapseAll",
          "remove": "true"
        }
      ]
    },
    {
      "name": "valid",
      "source": "dataset",
      "transform": [
        {
          "type": "filter",
          "expr": "isValid(datum.Amount) && isValid(datum.Node) && datum.Slot!==3"
        },
        {
          "type": "formula",
          "expr": "datum.GroupOrder*10+datum.Slot",
          "as": "ColumnKey"
        }
      ]
    },
    {
      "name": "expandables",
      "source": "valid",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "Node",
            "Children"
          ]
        },
        {
          "type": "filter",
          "expr": "datum.Children===1"
        },
        {
          "type": "formula",
          "expr": "datum.Node",
          "as": "key"
        }
      ]
    },
    {
      "name": "columns",
      "source": "valid",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "Group",
            "GroupOrder",
            "Metric",
            "Slot",
            "ColumnKey"
          ]
        },
        {
          "type": "collect",
          "sort": {
            "field": "ColumnKey",
            "order": "ascending"
          }
        },
        {
          "type": "window",
          "sort": {
            "field": "ColumnKey",
            "order": "ascending"
          },
          "ops": [
            "row_number"
          ],
          "as": [
            "ColumnNumber"
          ]
        },
        {
          "type": "formula",
          "expr": "datum.ColumnNumber-1",
          "as": "ColumnIndex"
        }
      ]
    },
    {
      "name": "groups",
      "source": "columns",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "Group",
            "GroupOrder"
          ],
          "fields": [
            "ColumnIndex",
            "ColumnIndex"
          ],
          "ops": [
            "min",
            "max"
          ],
          "as": [
            "First",
            "Last"
          ]
        }
      ]
    },
    {
      "name": "rows",
      "source": "valid",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "Node",
            "Label",
            "Parent",
            "Ancestor",
            "Depth",
            "Kind",
            "Order",
            "Children",
            "Section"
          ]
        },
        {
          "type": "filter",
          "expr": "datum.Depth===0 || (indata('open','key',datum.Parent) && (datum.Depth===1 || indata('open','key',datum.Ancestor)))"
        },
        {
          "type": "collect",
          "sort": {
            "field": "Order",
            "order": "ascending"
          }
        },
        {
          "type": "formula",
          "expr": "isValid(datum.Section) && datum.Section!==''?34:datum.Kind==='resultat'?10:0",
          "as": "Before"
        },
        {
          "type": "formula",
          "expr": "rowHeight+datum.Before",
          "as": "Extent"
        },
        {
          "type": "window",
          "sort": {
            "field": "Order",
            "order": "ascending"
          },
          "ops": [
            "sum"
          ],
          "fields": [
            "Extent"
          ],
          "as": [
            "RunningY"
          ],
          "frame": [
            null,
            0
          ]
        },
        {
          "type": "formula",
          "expr": "datum.RunningY-rowHeight",
          "as": "RowTop"
        }
      ]
    },
    {
      "name": "cells",
      "source": "valid",
      "transform": [
        {
          "type": "formula",
          "expr": "datum.Slot===1?datum.Amount:0",
          "as": "BaseValue"
        },
        {
          "type": "joinaggregate",
          "groupby": [
            "Node",
            "GroupOrder"
          ],
          "fields": [
            "BaseValue"
          ],
          "ops": [
            "sum"
          ],
          "as": [
            "BudgetAmount"
          ]
        },
        {
          "type": "formula",
          "expr": "indexof(datum.Metric,'B · ')===0?datum.Amount:datum.BudgetAmount",
          "as": "ReferenceAmount"
        },
        {
          "type": "formula",
          "expr": "datum.Slot===2 && isValid(datum.BudgetAmount) && (datum.Kind==='marginal' || datum.ReferenceAmount!==0)?(datum.Amount-datum.BudgetAmount)*(indexof(datum.Metric,'B · ')===0?-1:1)*(datum.Kind==='marginal'?100:100/abs(datum.ReferenceAmount)):null",
          "as": "Variance"
        },
        {
          "type": "formula",
          "expr": "isValid(datum.Variance)?round(datum.Variance*10)/10:null",
          "as": "RoundedVariance"
        },
        {
          "type": "formula",
          "expr": "!isValid(datum.RoundedVariance)?'—':(datum.RoundedVariance>0?'+':datum.RoundedVariance<0?'−':'')+replace(format(abs(datum.RoundedVariance),'.1f'),'.',',')+(datum.Kind==='marginal'?' pp':' %')",
          "as": "VarianceText"
        },
        {
          "type": "formula",
          "expr": "!isValid(datum.RoundedVariance) || datum.RoundedVariance===0?'#5B6B80':datum.RoundedVariance>0?'#007956':'#B42318'",
          "as": "VarianceColor"
        },
        {
          "type": "lookup",
          "from": "rows",
          "key": "Node",
          "fields": [
            "Node"
          ],
          "values": [
            "RowTop"
          ],
          "as": [
            "RowTop"
          ],
          "default": null
        },
        {
          "type": "filter",
          "expr": "isValid(datum.RowTop)"
        },
        {
          "type": "lookup",
          "from": "columns",
          "key": "ColumnKey",
          "fields": [
            "ColumnKey"
          ],
          "values": [
            "ColumnIndex"
          ],
          "as": [
            "ColumnIndex"
          ]
        }
      ]
    },
    {
      "name": "varianceCells",
      "source": "cells",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.Slot===2"
        }
      ]
    }
  ],
  "marks": [
    {
      "type": "group",
      "name": "body",
      "clip": true,
      "encode": {
        "update": {
          "x": {
            "value": 0
          },
          "y": {
            "signal": "headerH"
          },
          "width": {
            "signal": "width-12"
          },
          "height": {
            "signal": "bodyH"
          }
        }
      },
      "marks": [
        {
          "name": "rowBands",
          "type": "rect",
          "from": {
            "data": "rows"
          },
          "encode": {
            "update": {
              "x": {
                "value": 0
              },
              "y": {
                "signal": "datum.RowTop-scrollY"
              },
              "width": {
                "signal": "width-12"
              },
              "height": {
                "signal": "rowHeight"
              },
              "fill": {
                "signal": "datum.Kind==='resultat'?'#E1EAF5':datum.Kind==='marginal'?'#F3F6FA':datum.Node===hoverNode && datum.Children===1?'#F2F5F9':'#FFFFFF'"
              }
            }
          }
        },
        {
          "name": "rowLines",
          "type": "rule",
          "from": {
            "data": "rows"
          },
          "encode": {
            "update": {
              "x": {
                "value": 0
              },
              "x2": {
                "signal": "width-12"
              },
              "y": {
                "signal": "datum.RowTop+rowHeight-scrollY"
              },
              "stroke": {
                "value": "#E7ECF2"
              },
              "strokeWidth": {
                "value": 0.6
              }
            }
          }
        },
        {
          "type": "group",
          "name": "numbers",
          "clip": true,
          "encode": {
            "update": {
              "x": {
                "signal": "labelW"
              },
              "y": {
                "value": 0
              },
              "width": {
                "signal": "bodyW"
              },
              "height": {
                "signal": "bodyH"
              }
            }
          },
          "marks": [
            {
              "name": "cellText",
              "type": "text",
              "from": {
                "data": "cells"
              },
              "encode": {
                "update": {
                  "font": {
                    "value": "Segoe UI"
                  },
                  "fontSize": {
                    "signal": "datum.Kind==='konto'?15:16"
                  },
                  "fill": {
                    "field": "Color"
                  },
                  "baseline": {
                    "value": "middle"
                  },
                  "x": {
                    "signal": "floor(datum.ColumnIndex/2)*(columnW+budgetW)+budgetW+(datum.Slot===2?columnW:0)-(datum.Slot===2?76:12)-scrollX"
                  },
                  "y": {
                    "signal": "datum.RowTop+rowHeight/2-scrollY"
                  },
                  "text": {
                    "field": "Text"
                  },
                  "align": {
                    "value": "right"
                  },
                  "fontWeight": {
                    "signal": "datum.Kind==='resultat'?'bold':datum.Kind==='grupp'?'600':'normal'"
                  },
                  "fontStyle": {
                    "signal": "datum.Kind==='marginal'?'italic':'normal'"
                  },
                  "limit": {
                    "signal": "datum.Slot===2?columnW-88:budgetW-16"
                  },
                  "tooltip": {
                    "signal": "{'Post':datum.Label,'Period':datum.Group,'Jämförelse':datum.Metric,'Värde':datum.Text}"
                  }
                }
              }
            },
            {
              "name": "inlineVariance",
              "type": "text",
              "from": {
                "data": "varianceCells"
              },
              "encode": {
                "update": {
                  "font": {
                    "value": "Segoe UI"
                  },
                  "fontSize": {
                    "value": 12
                  },
                  "fill": {
                    "field": "VarianceColor"
                  },
                  "baseline": {
                    "value": "middle"
                  },
                  "x": {
                    "signal": "floor(datum.ColumnIndex/2)*(columnW+budgetW)+budgetW+(datum.Slot===2?columnW:0)-70-scrollX"
                  },
                  "y": {
                    "signal": "datum.RowTop+rowHeight/2-scrollY"
                  },
                  "text": {
                    "signal": "'('+datum.VarianceText+')'"
                  },
                  "align": {
                    "value": "left"
                  },
                  "limit": {
                    "value": 66
                  },
                  "tooltip": {
                    "signal": "{'Post':datum.Label,'Period':datum.Group,'Avvikelse':datum.VarianceText,'Tolkning':'Plus = bättre, minus = sämre'}"
                  }
                }
              }
            }
          ]
        },
        {
          "name": "rowLabelBackground",
          "type": "rect",
          "from": {
            "data": "rows"
          },
          "encode": {
            "update": {
              "x": {
                "value": 0
              },
              "y": {
                "signal": "datum.RowTop-scrollY"
              },
              "width": {
                "signal": "labelW"
              },
              "height": {
                "signal": "rowHeight"
              },
              "fill": {
                "signal": "datum.Kind==='resultat'?'#E1EAF5':datum.Kind==='marginal'?'#F3F6FA':datum.Node===hoverNode && datum.Children===1?'#F2F5F9':'#FFFFFF'"
              }
            }
          }
        },
        {
          "name": "sectionLabels",
          "type": "text",
          "from": {
            "data": "rows"
          },
          "encode": {
            "update": {
              "font": {
                "value": "Segoe UI"
              },
              "fontSize": {
                "value": 15
              },
              "fill": {
                "value": "#5B6B80"
              },
              "baseline": {
                "value": "middle"
              },
              "x": {
                "value": 8
              },
              "y": {
                "signal": "datum.RowTop-14-scrollY"
              },
              "text": {
                "signal": "datum.Before>0 && datum.Section?datum.Section:''"
              },
              "fontWeight": {
                "value": "bold"
              }
            }
          }
        },
        {
          "name": "rowLabels",
          "type": "text",
          "from": {
            "data": "rows"
          },
          "encode": {
            "update": {
              "font": {
                "value": "Segoe UI"
              },
              "fontSize": {
                "signal": "datum.Kind==='konto'?15:16"
              },
              "fill": {
                "signal": "datum.Kind==='marginal'?'#5B6B80':'#0F3163'"
              },
              "baseline": {
                "value": "middle"
              },
              "x": {
                "signal": "datum.Depth*18+28"
              },
              "y": {
                "signal": "datum.RowTop+rowHeight/2-scrollY"
              },
              "text": {
                "field": "Label"
              },
              "fontWeight": {
                "signal": "datum.Kind==='resultat'?'bold':datum.Kind==='grupp'?'600':'normal'"
              },
              "fontStyle": {
                "signal": "datum.Kind==='marginal'?'italic':'normal'"
              },
              "limit": {
                "signal": "labelW-datum.Depth*18-36"
              }
            }
          }
        },
        {
          "name": "chevrons",
          "type": "text",
          "from": {
            "data": "rows"
          },
          "encode": {
            "update": {
              "font": {
                "value": "Segoe UI"
              },
              "fontSize": {
                "value": 16
              },
              "fill": {
                "value": "#0F3163"
              },
              "baseline": {
                "value": "middle"
              },
              "x": {
                "signal": "datum.Depth*18+10"
              },
              "y": {
                "signal": "datum.RowTop+rowHeight/2-scrollY"
              },
              "text": {
                "signal": "datum.Children===1?(indata('open','key',datum.Node)?'▾':'▸'):''"
              },
              "fontWeight": {
                "value": "bold"
              }
            }
          }
        },
        {
          "name": "nodeHit",
          "type": "rect",
          "from": {
            "data": "rows"
          },
          "encode": {
            "update": {
              "x": {
                "value": 0
              },
              "y": {
                "signal": "datum.RowTop-scrollY"
              },
              "width": {
                "signal": "labelW"
              },
              "height": {
                "signal": "rowHeight"
              },
              "fill": {
                "value": "#FFFFFF"
              },
              "fillOpacity": {
                "value": 0
              },
              "cursor": {
                "signal": "datum.Children===1?'pointer':'default'"
              },
              "tooltip": {
                "signal": "datum.Children===1?'Klicka för att visa eller dölja underkategorier':datum.Kind==='konto'?'Kontopost utan underposter':'Beräknad rad utan underposter'"
              }
            }
          }
        }
      ]
    },
    {
      "name": "header",
      "type": "rect",
      "encode": {
        "update": {
          "x": {
            "value": 0
          },
          "y": {
            "value": 0
          },
          "width": {
            "signal": "width"
          },
          "height": {
            "signal": "headerH"
          },
          "fill": {
            "value": "#EEF2F7"
          },
          "fillOpacity": {
            "value": 1
          }
        }
      }
    },
    {
      "type": "rule",
      "name": "headerDivider",
      "encode": {
        "update": {
          "x": {
            "value": 0
          },
          "x2": {
            "signal": "width"
          },
          "y": {
            "signal": "headerH"
          },
          "stroke": {
            "value": "#B8C6D8"
          },
          "strokeWidth": {
            "value": 1
          }
        }
      }
    },
    {
      "name": "columnHeaders",
      "type": "group",
      "clip": true,
      "encode": {
        "update": {
          "x": {
            "signal": "labelW"
          },
          "y": {
            "value": 0
          },
          "width": {
            "signal": "bodyW"
          },
          "height": {
            "signal": "headerH"
          }
        }
      },
      "marks": [
        {
          "name": "monthHeaders",
          "type": "text",
          "from": {
            "data": "groups"
          },
          "encode": {
            "update": {
              "font": {
                "value": "Segoe UI"
              },
              "fontSize": {
                "value": 15
              },
              "fill": {
                "value": "#0F3163"
              },
              "baseline": {
                "value": "middle"
              },
              "x": {
                "signal": "(floor(datum.First/2)+0.5)*(columnW+budgetW)-scrollX"
              },
              "y": {
                "value": 21
              },
              "text": {
                "field": "Group"
              },
              "align": {
                "value": "center"
              },
              "fontWeight": {
                "value": "600"
              }
            }
          }
        },
        {
          "name": "metricHeaders",
          "type": "text",
          "from": {
            "data": "columns"
          },
          "encode": {
            "update": {
              "font": {
                "value": "Segoe UI"
              },
              "fontSize": {
                "value": 14
              },
              "fill": {
                "value": "#0F3163"
              },
              "baseline": {
                "value": "middle"
              },
              "x": {
                "signal": "floor(datum.ColumnIndex/2)*(columnW+budgetW)+budgetW+(datum.Slot===2?columnW:0)-(datum.Slot===2?76:12)-scrollX"
              },
              "y": {
                "signal": "datum.Slot===3 || indexof(datum.Metric,' · ')>=0?51:58"
              },
              "text": {
                "signal": "datum.Metric==='Föregående år'?'Föreg. år':datum.Slot===3?['Avvikelse','% / pp']:indexof(datum.Metric,' · ')>=0?split(datum.Metric,' · '):datum.Metric"
              },
              "align": {
                "value": "right"
              },
              "lineHeight": {
                "value": 16
              },
              "limit": {
                "signal": "columnW-12"
              },
              "tooltip": {
                "field": "Metric"
              }
            }
          }
        },
        {
          "type": "rule",
          "from": {
            "data": "groups"
          },
          "encode": {
            "update": {
              "x": {
