"Group",'Budgetkolumner'[Grupp],
"GroupOrder",'Budgetkolumner'[MånadID],
"Metric",'Budgetkolumner'[Kolumn],
"Slot",'Budgetkolumner'[Position],"Amount",[Amount],"Text",[Text],"Color",[Color]),TREATAS({2026},'Budgetår'[År]),TREATAS({7,8,9},'Budgetmånader'[Nummer]),TREATAS({1},'Budgetscenarion'[ScenarioID]),TREATAS({1},'Budgetjämförelse'[Ordning]))
ORDER BY [Order],[GroupOrder],[Slot]

