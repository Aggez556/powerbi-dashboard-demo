'Budgetkolumner'[MånadID],
'Budgetkolumner'[Kolumn],
'Budgetkolumner'[Position],"Amount",[Rapportvärde],"Text",[Rapporttext],"Color",[Rapportfärg]),"Node",'Budgetrapportnoder'[NodID],
"Label",'Budgetrapportnoder'[Etikett],
"Parent",'Budgetrapportnoder'[Förälder],
"Ancestor",'Budgetrapportnoder'[Överförälder],
"Depth",'Budgetrapportnoder'[Nivå],
"Kind",'Budgetrapportnoder'[Typ],
"Order",'Budgetrapportnoder'[Ordning],
"Children",'Budgetrapportnoder'[HarBarn],
