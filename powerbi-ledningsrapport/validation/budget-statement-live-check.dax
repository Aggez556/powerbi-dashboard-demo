EVALUATE
CALCULATETABLE(SELECTCOLUMNS(SUMMARIZECOLUMNS('Budgetrapportnoder'[NodID],
'Budgetrapportnoder'[Etikett],
'Budgetrapportnoder'[Förälder],
'Budgetrapportnoder'[Överförälder],
