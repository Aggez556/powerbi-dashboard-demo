					Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Headers, {{"Datumnyckel", Int64.Type}, {"Områdesnyckel", Int64.Type}, {"Kostnadstyp", type text}, {"Belopp", Currency.Type}, {"Artikelnyckel", Int64.Type}, {"Kundnyckel", Int64.Type}}, "en-US")
