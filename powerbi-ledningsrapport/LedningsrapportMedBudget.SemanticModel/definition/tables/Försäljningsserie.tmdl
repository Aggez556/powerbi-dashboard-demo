/// Reproducerbart analysunderlag.
table Försäljningsserie
	lineageTag: 1597cfc2-4fab-46bc-b905-5a3c518e25f9

	column Serie
		dataType: string
		lineageTag: f9e4885b-2560-40d5-a8c4-dc6e8c77d17e
		summarizeBy: none
		sourceColumn: Serie
		sortByColumn: Ordning

	column Typ
		dataType: string
		isHidden
		lineageTag: 61752935-0caf-494d-84d8-8e54ed9fcef1
		summarizeBy: none
		sourceColumn: Typ

	column Nyckel
		dataType: int64
		isHidden
		lineageTag: e2fee779-a94d-4571-a2f2-ded1589f2ad8
		summarizeBy: none
		sourceColumn: Nyckel

	column Ordning
		dataType: int64
		isHidden
		lineageTag: a4d74bf5-c234-4ed0-9598-98648c867219
		summarizeBy: none
		sourceColumn: Ordning

	partition Försäljningsserie = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "/Försäljningsserie.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Headers, {{"Serie", type text}, {"Typ", type text}, {"Nyckel", Int64.Type}, {"Ordning", Int64.Type}}, "en-US")
				in
					Typed

