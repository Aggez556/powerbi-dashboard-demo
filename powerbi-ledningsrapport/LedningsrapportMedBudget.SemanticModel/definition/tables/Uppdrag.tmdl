	partition Uppdrag = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "/Uppdrag.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Headers, {{"Uppdragsnyckel", Int64.Type}, {"Datumnyckel", Int64.Type}, {"Kundnyckel", Int64.Type}, {"Områdesnyckel", Int64.Type}, {"Status", type text}, {"Timmar", Int64.Type}}, "en-US")
				in
					Typed

