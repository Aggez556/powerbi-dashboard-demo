/// Reproducerbar uppdragsanalys. Separata datumroller för utfall och plan.
table Arbetskapacitet
	lineageTag: e042e544-0cd0-4e05-8f65-817a2d1a263c

	column ResursID
		dataType: int64
		isHidden
		lineageTag: 0b968044-0cd2-4368-822e-7f2f04012f63
		summarizeBy: none
		sourceColumn: ResursID

	column Datumnyckel
		dataType: int64
		isHidden
		lineageTag: fc94e242-5e17-42e6-93bc-4ac7b5b2f2e3
		summarizeBy: none
		sourceColumn: Datumnyckel

	column Schematimmar
		dataType: double
		isHidden
		lineageTag: 6b09e0bb-441f-4d2f-beae-aa89d723f9fc
		summarizeBy: none
		sourceColumn: Schematimmar

	column Frånvaro
		dataType: double
		isHidden
		lineageTag: 2ccd4557-d6e3-4abd-ad32-45cf46374dd9
		summarizeBy: none
		sourceColumn: Frånvaro

	column Tillgängligt
		dataType: double
		isHidden
		lineageTag: d3efbdad-e967-4d11-be18-38baa71a0263
		summarizeBy: none
		sourceColumn: Tillgängligt

	partition Arbetskapacitet = m
		mode: import
		source =
				let
				 Source=Csv.Document(File.Contents(DataFolder & "/Arbetskapacitet.csv"),[Delimiter=",",Encoding=65001,QuoteStyle=QuoteStyle.Csv]),
				 Headers=Table.PromoteHeaders(Source,[PromoteAllScalars=true]),
				 Typed=Table.TransformColumnTypes(Headers,{{"ResursID", Int64.Type},{"Datumnyckel", Int64.Type},{"Schematimmar", type number},{"Frånvaro", type number},{"Tillgängligt", type number}},"en-US")
				in Typed

