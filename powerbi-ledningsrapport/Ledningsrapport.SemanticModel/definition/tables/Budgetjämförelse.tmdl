/// Budget: Budgetjämförelse. Utility selectors are intentionally disconnected.
table Budgetjämförelse
	lineageTag: 4b9c0913-e0bc-40e5-872f-5e5ca8d716fe

	column Läge
		dataType: string
		lineageTag: 420cce56-3861-4cef-823d-7bbe8982ddab
		summarizeBy: none
		sourceColumn: Läge
		sortByColumn: Ordning

	column Ordning
		dataType: int64
		isHidden
		lineageTag: 4003e93c-a169-4f3b-9345-72430367adda
		summarizeBy: none
		sourceColumn: Ordning

	partition Budgetjämförelse = m
		mode: import
		source =
				let
				 Source=Csv.Document(File.Contents(DataFolder & "/Budgetjämförelse.csv"),[Delimiter=",",Encoding=65001,QuoteStyle=QuoteStyle.Csv]),
				 Headers=Table.PromoteHeaders(Source,[PromoteAllScalars=true]),
				 Typed=Table.TransformColumnTypes(Headers,{{"Läge", type text}, {"Ordning", Int64.Type}},"en-US")
				in Typed

