	measure 'Trend timmar' =
			VAR _g=SELECTEDVALUE('Resursval'[Resursgrupp],"Alla")
			VAR _valid=CALCULATE(COUNTROWS('Resurser'),REMOVEFILTERS('Resurser'[ResursID],'Resurser'[Medarbetare],'Resurser'[Resursgrupp]),'Resurser'[Resursgrupp]=_g)>0
			VAR _ids=CALCULATETABLE(VALUES('Resurser'[ResursID]),KEEPFILTERS(FILTER(VALUES('Resurser'[Resursgrupp]),_g="Alla" || NOT _valid || 'Resurser'[Resursgrupp]=_g)))
			VAR _m=SELECTEDVALUE('Trendaxel'[Månadsstart]) VAR _s=VALUE(FORMAT(_m,"yyyyMMdd")) VAR _e=VALUE(FORMAT(EOMONTH(_m,0),"yyyyMMdd")) RETURN IF(_m>=[Trendstart] && _m<=[Periodslut],CALCULATE(SUM('Utförd tid'[Timmar]),TREATAS(_ids,'Resurser'[ResursID]),FILTER(ALL('Utförd tid'[Datumnyckel]),'Utförd tid'[Datumnyckel]>=_s && 'Utförd tid'[Datumnyckel]<=_e)))
		formatString: #,##0
		displayFolder: Uppdrag
		lineageTag: 477661bf-d08e-44f7-b237-120ddeccd49f

	measure 'Trend kapacitet' =
			VAR _g=SELECTEDVALUE('Resursval'[Resursgrupp],"Alla")
			VAR _valid=CALCULATE(COUNTROWS('Resurser'),REMOVEFILTERS('Resurser'[ResursID],'Resurser'[Medarbetare],'Resurser'[Resursgrupp]),'Resurser'[Resursgrupp]=_g)>0
			VAR _ids=CALCULATETABLE(VALUES('Resurser'[ResursID]),KEEPFILTERS(FILTER(VALUES('Resurser'[Resursgrupp]),_g="Alla" || NOT _valid || 'Resurser'[Resursgrupp]=_g)))
			VAR _m=SELECTEDVALUE('Trendaxel'[Månadsstart]) VAR _s=VALUE(FORMAT(_m,"yyyyMMdd")) VAR _e=VALUE(FORMAT(EOMONTH(_m,0),"yyyyMMdd")) RETURN IF(_m>=[Trendstart] && _m<=[Periodslut],CALCULATE(SUM('Arbetskapacitet'[Tillgängligt]),TREATAS(_ids,'Resurser'[ResursID]),FILTER(ALL('Arbetskapacitet'[Datumnyckel]),'Arbetskapacitet'[Datumnyckel]>=_s && 'Arbetskapacitet'[Datumnyckel]<=_e)))
		formatString: #,##0
		displayFolder: Uppdrag
		lineageTag: aa341215-5bc2-464b-9e2c-ae1c4a0e8bb9

