			VAR _s=VALUE(FORMAT([Periodstart],"yyyyMMdd")) VAR _e=VALUE(FORMAT([Periodslut],"yyyyMMdd")) RETURN DIVIDE(CALCULATE(SUMX('Arbetskapacitet','Arbetskapacitet'[Tillgängligt]*RELATED('Resurser'[Mål])),TREATAS(_ids,'Resurser'[ResursID]),FILTER(ALL('Arbetskapacitet'[Datumnyckel]),'Arbetskapacitet'[Datumnyckel]>=_s && 'Arbetskapacitet'[Datumnyckel]<=_e)),[Utfall kapacitet])
