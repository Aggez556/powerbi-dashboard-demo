/// Reproducerbar uppdragsanalys. Separata datumroller för utfall och plan.
table Planinställning
	lineageTag: a7dc1194-675e-44f9-86bd-831644b50673

	measure 'Resursval tillgängligt' = VAR _g=SELECTEDVALUE('Resursval'[Resursgrupp]) RETURN IF(_g="Alla" || CALCULATE(COUNTROWS('Resurser'),'Resurser'[Resursgrupp]=_g)>0,1,0)
		formatString: #,##0
		displayFolder: Uppdrag
		lineageTag: dedae0a3-1037-4cf9-9aba-574425c1a5fb

	measure 'Resursurval text' =
			VAR _g=SELECTEDVALUE('Resursval'[Resursgrupp],"Alla")
			VAR _valid=CALCULATE(COUNTROWS('Resurser'),REMOVEFILTERS('Resurser'[ResursID],'Resurser'[Medarbetare],'Resurser'[Resursgrupp]),'Resurser'[Resursgrupp]=_g)>0
			VAR _ids=CALCULATETABLE(VALUES('Resurser'[ResursID]),KEEPFILTERS(FILTER(VALUES('Resurser'[Resursgrupp]),_g="Alla" || NOT _valid || 'Resurser'[Resursgrupp]=_g)))
			RETURN IF(_g="Alla","Alla resursgrupper",IF(_valid,_g,"Alla resursgrupper · tidigare grupp gäller inte området"))
		formatString: @
		displayFolder: Uppdrag
		lineageTag: a7d3a493-0b0a-40dc-9ea4-5dcea07e86e3

	measure 'Planläge datum' = MAX('Planinställning'[Planläge])
		formatString: yyyy-MM-dd
		displayFolder: Uppdrag
		lineageTag: 54d638a4-4d6c-4958-a361-9889293d9284

	measure 'Planperiod text' = "Kommande beläggning · Planläge: " & FORMAT([Planläge datum],"d MMM yyyy","sv-SE") & " · " & FORMAT(MAX('Planinställning'[Från]),"d MMM","sv-SE") & "–" & FORMAT(MAX('Planinställning'[Till]),"d MMM yyyy","sv-SE")
		formatString: @
		displayFolder: Uppdrag
		lineageTag: fa11db1c-0516-41f8-a8e1-ec49f3051649

	measure 'Utfall periodtext' = "Historiskt utfall · " & FORMAT([Periodstart],"MMM yyyy","sv-SE") & "–" & FORMAT([Periodslut],"MMM yyyy","sv-SE")
		formatString: @
		displayFolder: Uppdrag
		lineageTag: d91ceacb-d003-4e6b-9760-4cebccd134c6

	measure 'Uppdrag trendrubrik' = ```
			"Debiteringsgrad över tid"
			```
		formatString: @
		displayFolder: Uppdrag
		lineageTag: e0c16e6d-a4dc-4a02-abe7-b710b77590a9

	measure 'Uppdrag utförda' =
			VAR _g=SELECTEDVALUE('Resursval'[Resursgrupp],"Alla")
			VAR _valid=CALCULATE(COUNTROWS('Resurser'),REMOVEFILTERS('Resurser'[ResursID],'Resurser'[Medarbetare],'Resurser'[Resursgrupp]),'Resurser'[Resursgrupp]=_g)>0
			VAR _ids=CALCULATETABLE(VALUES('Resurser'[ResursID]),KEEPFILTERS(FILTER(VALUES('Resurser'[Resursgrupp]),_g="Alla" || NOT _valid || 'Resurser'[Resursgrupp]=_g)))
			VAR _s=VALUE(FORMAT([Periodstart],"yyyyMMdd")) VAR _e=VALUE(FORMAT([Periodslut],"yyyyMMdd")) RETURN CALCULATE(DISTINCTCOUNT('Uppdragsregister'[UppdragID]),REMOVEFILTERS('Datum'),TREATAS(_ids,'Resurser'[ResursID]),FILTER(ALL('Uppdragsregister'[Slutförd]),'Uppdragsregister'[Slutförd]>=_s && 'Uppdragsregister'[Slutförd]<=_e),'Uppdragsregister'[Status]="Avslutat")
		formatString: #,##0
		displayFolder: Uppdrag
		lineageTag: 022fa33a-016c-4d7e-824f-97be4aa2c757

	measure 'Uppdrag utförda föregående' =
			VAR _g=SELECTEDVALUE('Resursval'[Resursgrupp],"Alla")
			VAR _valid=CALCULATE(COUNTROWS('Resurser'),REMOVEFILTERS('Resurser'[ResursID],'Resurser'[Medarbetare],'Resurser'[Resursgrupp]),'Resurser'[Resursgrupp]=_g)>0
			VAR _ids=CALCULATETABLE(VALUES('Resurser'[ResursID]),KEEPFILTERS(FILTER(VALUES('Resurser'[Resursgrupp]),_g="Alla" || NOT _valid || 'Resurser'[Resursgrupp]=_g)))
			VAR _s=VALUE(FORMAT([Jämförelsestart],"yyyyMMdd")) VAR _e=VALUE(FORMAT([Jämförelseslut],"yyyyMMdd")) RETURN CALCULATE(DISTINCTCOUNT('Uppdragsregister'[UppdragID]),REMOVEFILTERS('Datum'),TREATAS(_ids,'Resurser'[ResursID]),FILTER(ALL('Uppdragsregister'[Slutförd]),'Uppdragsregister'[Slutförd]>=_s && 'Uppdragsregister'[Slutförd]<=_e),'Uppdragsregister'[Status]="Avslutat")
		formatString: #,##0
		displayFolder: Uppdrag
		lineageTag: e2d378a6-a024-49d6-9a7e-8a238aab50c6

	measure 'Utfall timmar' =
