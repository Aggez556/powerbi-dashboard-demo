	measure 'Trend mål' = IF(NOT ISBLANK([Trend kapacitet]),DIVIDE(SUMX('Resurser','Resurser'[Veckotimmar]*'Resurser'[Mål]),SUM('Resurser'[Veckotimmar])))
		formatString: 0 %
