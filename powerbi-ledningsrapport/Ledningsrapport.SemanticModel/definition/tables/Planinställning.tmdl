			VAR _ids=CALCULATETABLE(VALUES('Resurser'[ResursID]),KEEPFILTERS(FILTER(VALUES('Resurser'[Resursgrupp]),_g="Alla" || NOT _valid || 'Resurser'[Resursgrupp]=_g)))
			VAR _s=VALUE(FORMAT([Jämförelsestart],"yyyyMMdd")) VAR _e=VALUE(FORMAT([Historiskt jämförelseslut],"yyyyMMdd")) RETURN IF(_s<=_e,CALCULATE(SUM('Utförd tid'[Timmar]),REMOVEFILTERS('Datum'),TREATAS(_ids,'Resurser'[ResursID]),FILTER(ALL('Utförd tid'[Datumnyckel]),'Utförd tid'[Datumnyckel]>=_s && 'Utförd tid'[Datumnyckel]<=_e),'Utförd tid'[Godkänd]="Ja",'Utförd tid'[Debiterbar]="Ja"))
