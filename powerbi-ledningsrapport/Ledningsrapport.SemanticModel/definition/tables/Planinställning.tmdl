	measure 'Uppdrag prognos' = VAR _r=SELECTEDVALUE('Uppdragsregister'[Slutintäkt]) RETURN DIVIDE(_r-SELECTEDVALUE('Uppdragsregister'[KostnadHittills])-SELECTEDVALUE('Uppdragsregister'[ÅterståendeKostnad]),_r)
		formatString: 0.0 %
