/// Reproducerbar lokal demodata; Kunder.csv.
table Kunder
	lineageTag: 8281f140-d94c-4bce-924b-e938d15f773d

	/// Källfält i lokal demodata: Kunder.Kundnyckel.
	measure 'Bransch månadsförsäljning' = VAR _m=SELECTEDVALUE('Trendaxel'[Månadsstart]) VAR _start=[Periodstart] VAR _end=MIN([Periodslut],[Senaste utfall]) RETURN IF(NOT ISBLANK(_m) && _m>=_start && _m<=_end,CALCULATE([Nettoomsättning bas],REMOVEFILTERS('Datum'),DATESBETWEEN('Datum'[Datum],_m,EOMONTH(_m,0))))
		formatString: #,##0 "kr"
		displayFolder: Kunder\Branschutveckling
		lineageTag: bb6ed385-bad7-479a-8654-70f568e00f67

	measure 'Bransch månadsförsäljning föregående år' = VAR _m=SELECTEDVALUE('Trendaxel'[Månadsstart]) VAR _start=[Periodstart] VAR _end=MIN([Periodslut],[Senaste utfall]) VAR _previous=EDATE(_m,-12) RETURN IF(NOT ISBLANK(_m) && _m>=_start && _m<=_end,CALCULATE([Nettoomsättning bas],REMOVEFILTERS('Datum'),DATESBETWEEN('Datum'[Datum],_previous,EOMONTH(_previous,0))))
		formatString: #,##0 "kr"
		displayFolder: Kunder\Branschutveckling
		lineageTag: a3ac9bcc-f46c-4fed-9a46-d2950587bcf7

	measure 'Bransch månadsförändring kronor' = VAR _a=[Bransch månadsförsäljning] VAR _b=[Bransch månadsförsäljning föregående år] RETURN IF(ISBLANK(_a)&&ISBLANK(_b),BLANK(),COALESCE(_a,0)-COALESCE(_b,0))
		formatString: +#,##0 "kr";−#,##0 "kr";0 "kr"
		displayFolder: Kunder\Branschutveckling
		lineageTag: feb55878-0f4c-44a0-a235-58e69ca9fc60

	measure 'Bransch månadsförändring procent' = VAR _b=[Bransch månadsförsäljning föregående år] RETURN IF(_b>0,DIVIDE([Bransch månadsförändring kronor],_b))
		formatString: +0.0 %;−0.0 %;0.0 %
		displayFolder: Kunder\Branschutveckling
		lineageTag: b0474bcc-a1b6-42fd-a880-f99d28027f92

	measure 'Bransch månadsförändring Mkr' = VAR _v=[Bransch månadsförändring kronor] RETURN IF(ISBLANK(_v),BLANK(),CONVERT(_v,DOUBLE)/1000000)
		formatString: +0.00 "Mkr";−0.00 "Mkr";0.00 "Mkr"
		displayFolder: Kunder\Branschutveckling
		lineageTag: a3fee201-24c3-4ed0-b143-ff159730b7df

	measure 'Bransch axeltak procent' = VAR _start=[Periodstart] VAR _end=MIN([Periodslut],[Senaste utfall]) VAR _months=FILTER(ALLSELECTED('Trendaxel'[Månadsstart]),'Trendaxel'[Månadsstart]>=_start && 'Trendaxel'[Månadsstart]<=_end) VAR _branches=ALLSELECTED('Kunder'[Kundbransch]) VAR _values=ADDCOLUMNS(CROSSJOIN(_months,_branches),"@value",CALCULATE([Bransch månadsförändring procent])) VAR _maximum=MAX(0,MAXX(_values,[@value])) VAR _minimum=MIN(0,MINX(_values,[@value])) VAR _padding=MAX(0.05,(_maximum-_minimum)*0.08) RETURN CEILING(_maximum+_padding,0.05)
		formatString: 0.00
		displayFolder: Kunder\Branschutveckling
		lineageTag: 7ff71bda-ae4f-424a-a1b2-ccb26d4e2ff8

	measure 'Bransch axelgolv procent' = VAR _start=[Periodstart] VAR _end=MIN([Periodslut],[Senaste utfall]) VAR _months=FILTER(ALLSELECTED('Trendaxel'[Månadsstart]),'Trendaxel'[Månadsstart]>=_start && 'Trendaxel'[Månadsstart]<=_end) VAR _branches=ALLSELECTED('Kunder'[Kundbransch]) VAR _values=ADDCOLUMNS(CROSSJOIN(_months,_branches),"@value",CALCULATE([Bransch månadsförändring procent])) VAR _maximum=MAX(0,MAXX(_values,[@value])) VAR _minimum=MIN(0,MINX(_values,[@value])) VAR _padding=MAX(0.05,(_maximum-_minimum)*0.08) RETURN -CEILING(-_minimum+_padding,0.05)
		formatString: 0.00
		displayFolder: Kunder\Branschutveckling
		lineageTag: 0fec1a0e-8fd5-4097-a741-e7cf4cd0a0e2

	measure 'Bransch axeltak Mkr' = VAR _start=[Periodstart] VAR _end=MIN([Periodslut],[Senaste utfall]) VAR _months=FILTER(ALLSELECTED('Trendaxel'[Månadsstart]),'Trendaxel'[Månadsstart]>=_start && 'Trendaxel'[Månadsstart]<=_end) VAR _branches=ALLSELECTED('Kunder'[Kundbransch]) VAR _values=ADDCOLUMNS(CROSSJOIN(_months,_branches),"@value",CALCULATE([Bransch månadsförändring Mkr])) VAR _maximum=MAX(0,MAXX(_values,[@value])) VAR _minimum=MIN(0,MINX(_values,[@value])) VAR _padding=MAX(0.1,(_maximum-_minimum)*0.08) RETURN CEILING(_maximum+_padding,0.1)
		formatString: 0.00
		displayFolder: Kunder\Branschutveckling
		lineageTag: 1bfe1405-4e1f-4332-bc20-f31619c6bdeb

	measure 'Bransch axelgolv Mkr' = VAR _start=[Periodstart] VAR _end=MIN([Periodslut],[Senaste utfall]) VAR _months=FILTER(ALLSELECTED('Trendaxel'[Månadsstart]),'Trendaxel'[Månadsstart]>=_start && 'Trendaxel'[Månadsstart]<=_end) VAR _branches=ALLSELECTED('Kunder'[Kundbransch]) VAR _values=ADDCOLUMNS(CROSSJOIN(_months,_branches),"@value",CALCULATE([Bransch månadsförändring Mkr])) VAR _maximum=MAX(0,MAXX(_values,[@value])) VAR _minimum=MIN(0,MINX(_values,[@value])) VAR _padding=MAX(0.1,(_maximum-_minimum)*0.08) RETURN -CEILING(-_minimum+_padding,0.1)
		formatString: 0.00
		displayFolder: Kunder\Branschutveckling
		lineageTag: 5c7db64f-6ce9-4a0e-93de-641263028d92

	column Kundnyckel
		dataType: int64
		isHidden
		lineageTag: 2dc270a4-78ca-4b16-a126-05deb69382fc
		summarizeBy: none
		sourceColumn: Kundnyckel

	/// Källfält i lokal demodata: Kunder.Kund.
	column Kund
		dataType: string
		lineageTag: ef739426-a1cf-4b38-ad97-3d6ca2b34198
		summarizeBy: none
		sourceColumn: Kund

	/// Källfält i lokal demodata: Kunder.Ort.
	column Ort
		dataType: string
		lineageTag: 222de013-0109-454e-9270-a7df0550f285
		summarizeBy: none
		sourceColumn: Ort

	/// Underlag för försäljningsanalys.
	column Kundbransch
		dataType: string
		lineageTag: c1824939-d020-4cf3-a869-8f3478de29d9
		summarizeBy: none
		sourceColumn: Kundbransch

	column 'Första köp'
		dataType: int64
		isHidden
		lineageTag: 6a599f9c-638f-410c-8b2a-ac32cbd1c0aa
		summarizeBy: none
		sourceColumn: Första köp

	column 'Historiskt köp före data'
		dataType: string
		isHidden
		lineageTag: 27f8d134-d961-4273-ad6d-af7ade2681ce
		summarizeBy: none
		sourceColumn: Historiskt köp före data

	partition Kunder = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "/Kunder.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Headers, {{"Kundnyckel", Int64.Type}, {"Kund", type text}, {"Ort", type text}, {"Kundbransch", type text}, {"Första köp", Int64.Type}, {"Historiskt köp före data", type text}}, "en-US")
				in
					Typed

