/// Reproducerbar uppdragsanalys. Separata datumroller för utfall och plan.
table Planveckor
	lineageTag: c826a6c0-0bd2-4bcf-b1d9-f8bc033a3877

	column VeckaID
		dataType: int64
		isHidden
		lineageTag: e813c159-c34a-42c6-9492-146dbe5b350c
		summarizeBy: none
		sourceColumn: VeckaID

	column Vecka
		dataType: string
		lineageTag: 5212852d-60c3-4507-a812-6e1493a01d89
		summarizeBy: none
		sourceColumn: Vecka
		sortByColumn: VeckaID

	column Veckostart
		dataType: dateTime
		lineageTag: 8764f960-8c7d-42a5-aa0f-b117fd13dbc6
		summarizeBy: none
		sourceColumn: Veckostart

	column Veckoslut
		dataType: dateTime
		lineageTag: ff76d189-17e9-48a9-bdde-15aee431ff8b
		summarizeBy: none
		sourceColumn: Veckoslut

	partition Planveckor = m
		mode: import
		source =
				let
				 Source=Csv.Document(File.Contents(DataFolder & "/Planveckor.csv"),[Delimiter=",",Encoding=65001,QuoteStyle=QuoteStyle.Csv]),
				 Headers=Table.PromoteHeaders(Source,[PromoteAllScalars=true]),
				 Typed=Table.TransformColumnTypes(Headers,{{"VeckaID", Int64.Type},{"Vecka", type text},{"Veckostart", type date},{"Veckoslut", type date}},"en-US")
				in Typed

