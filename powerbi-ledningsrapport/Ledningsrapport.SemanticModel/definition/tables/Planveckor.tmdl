/// Reproducerbar uppdragsanalys. Separata datumroller för utfall och plan.
table Planveckor
	lineageTag: c826a6c0-0bd2-4bcf-b1d9-f8bc033a3877

	column VeckaID
		dataType: int64
		isHidden
		lineageTag: e813c159-c34a-42c6-9492-146dbe5b350c
		summarizeBy: none
		sourceColumn: VeckaID

	column Vecka
		dataType: string
		lineageTag: 5212852d-60c3-4507-a812-6e1493a01d89
		summarizeBy: none
		sourceColumn: Vecka
		sortByColumn: VeckaID

	column Veckostart
		dataType: dateTime
		formatString: Long Date
		lineageTag: 8764f960-8c7d-42a5-aa0f-b117fd13dbc6
		summarizeBy: none
		sourceColumn: Veckostart

		variation Variation
			isDefault
			relationship: cea9dd8d-ff86-4cd9-81dd-43a986b91468
			defaultHierarchy: LocalDateTable_1e2a6c4b-ef7f-46fc-898a-6eb8f826f492.Datumhierarki

		annotation UnderlyingDateTimeDataType = Date

	column Veckoslut
		dataType: dateTime
		formatString: Long Date
		lineageTag: ff76d189-17e9-48a9-bdde-15aee431ff8b
		summarizeBy: none
