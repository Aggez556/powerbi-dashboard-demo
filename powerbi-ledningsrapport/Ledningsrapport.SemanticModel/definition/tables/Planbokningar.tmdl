		source =
				let
				 Source=Csv.Document(File.Contents(DataFolder & "/Planbokningar.csv"),[Delimiter=",",Encoding=65001,QuoteStyle=QuoteStyle.Csv]),
				 Headers=Table.PromoteHeaders(Source,[PromoteAllScalars=true]),
				 Typed=Table.TransformColumnTypes(Headers,{{"ResursID", Int64.Type},{"Datumnyckel", Int64.Type},{"VeckaID", Int64.Type},{"Snapshot", Int64.Type},{"UppdragID", Int64.Type},{"Kapacitet", type number},{"Bokat", type number},{"Ledigt", type number},{"Överbokat", type number}},"en-US")
				in Typed

