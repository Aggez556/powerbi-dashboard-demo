		displayFolder: Kundanalys
		lineageTag: 02194975-3740-4fdb-94b8-99428d3b4b9b

	measure 'Kunder logo undertext' = FORMAT([Kunder förlorade],"0","sv-SE") & " förlorade av " & FORMAT([Kunder föregående],"0","sv-SE") & " kunder"
		formatString: General
		displayFolder: Kundanalys
		lineageTag: f30fb4d6-9e49-4ec7-b5f2-ecc5d35341fa

	measure 'Kunder churn undertext' = VAR _d=[Kundintäkt ingående bas A]-[Kundintäkt föregående] RETURN IF(ISBLANK([Kunder revenue churn]),"Ej jämförbart",FORMAT(_d/1000000,"+0.0;−0.0;0.0","sv-SE") & " Mkr mot föregående period")
		formatString: General
		displayFolder: Kundanalys
		lineageTag: 2c7d81f9-b708-4737-8c1a-1fed9f284b28

	measure 'Kunder andel undertext' = FORMAT(([Kundintäkt helt nya A]+[Kundintäkt återaktiverade A])/1000000,"0.0","sv-SE") & " Mkr av " & FORMAT([Kundintäkt aktuell]/1000000,"0.0","sv-SE") & " Mkr"
		formatString: General
		displayFolder: Kundanalys
		lineageTag: b4da6984-cd44-48af-bddd-369822625e6c

	measure 'Kunder churn färg' = SWITCH(TRUE(),ISBLANK([Kunder revenue churn]),"#5B6B80",[Kunder revenue churn]>0,"#B42318",[Kunder revenue churn]<0,"#007956","#5B6B80")
		formatString: General
		displayFolder: Kundanalys
		lineageTag: 0a11bb06-0cc4-4580-858e-40107deec898

	measure 'Kundgrupp månadsintäkt' = VAR _month=SELECTEDVALUE('Trendaxel'[Månadsstart]) VAR _groupCode=SELECTEDVALUE('Kundgrupper'[Ordning])+1 VAR _start=[Kundperiod start] VAR _end=[Periodslut] VAR _cohortCustomers=FILTER(VALUES('Kunder'[Kundnyckel]),[Kundstatus kod]=_groupCode) RETURN IF(_month>=_start && _month<=_end,CONVERT(SUMX(_cohortCustomers,CALCULATE([Nettoomsättning bas],REMOVEFILTERS('Datum'),DATESBETWEEN('Datum'[Datum],_month,EOMONTH(_month,0)))),DOUBLE)/1000000)
		formatString: 0.0
		displayFolder: Kundanalys
		lineageTag: 46daaeec-81f1-4372-88e1-b2260a0329fe

	measure 'Kundgrupp andel' = DIVIDE([Kundgrupp månadsintäkt],SUMX(ALL('Kundgrupper'),[Kundgrupp månadsintäkt]))
		formatString: 0.0 %
		displayFolder: Kundanalys
		lineageTag: 320d8e62-ff28-40fa-b8e2-b698c80dd358

	measure 'Kundgrupp summering' = "Befintliga " & FORMAT([Kundintäkt fortsatta A]/1000000,"0.0","sv-SE") & " · Helt nya " & FORMAT([Kundintäkt helt nya A]/1000000,"0.0","sv-SE") & " · Återaktiverade " & FORMAT([Kundintäkt återaktiverade A]/1000000,"0.0","sv-SE") & " Mkr"
		formatString: General
		displayFolder: Kundanalys
		lineageTag: 4db672bf-3a74-4f9a-9046-903304ec7b9b

	measure 'Kundbas bryggsteg' = SWITCH(SELECTEDVALUE('Kundbassteg'[Ordning]),0,[Kunder föregående],1,[Kunder helt nya],2,[Kunder återaktiverade],3,-[Kunder förlorade])
		formatString: 0
		displayFolder: Kundanalys
		lineageTag: ed3789f7-d577-47dd-bf1e-2236aaa1a503

	measure 'Kundintäkt bryggsteg' = SWITCH(SELECTEDVALUE('Kundintäktssteg'[Ordning]),0,[Kundintäkt föregående],1,[Kundintäkt förlorade A]-[Kundintäkt förlorade B],2,[Kunder minskade köp],3,[Kunder ökade köp],4,[Kundintäkt helt nya A],5,[Kundintäkt återaktiverade A])/1000000
		formatString: 0.0
		displayFolder: Kundanalys
		lineageTag: 0cf2157a-ea99-4a8c-b50d-b1c8db6df331

	measure 'Kundbas bryggtak' = MAX([Kunder aktiva]+[Kunder förlorade],[Kunder föregående])*1.2
		formatString: 0
		displayFolder: Kundanalys
		lineageTag: f3775a6b-cbe0-4c94-a87b-823e0ad6963e

	measure 'Kundintäkt bryggtak' = MAX([Kundintäkt föregående],[Kundintäkt aktuell])/1000000*1.2
		formatString: 0.0
		displayFolder: Kundanalys
		lineageTag: c4212a38-92d8-4baf-8eeb-1887d3f1edc8

	measure 'Kundbas ekvation' = FORMAT([Kunder föregående],"0") & " + " & FORMAT([Kunder helt nya],"0") & " + " & FORMAT([Kunder återaktiverade],"0") & " − " & FORMAT([Kunder förlorade],"0") & " = " & FORMAT([Kunder aktiva],"0")
		formatString: General
		displayFolder: Kundanalys
		lineageTag: 94941ef5-acb4-4716-be1d-fdcd5c1c9781

	measure 'Kundintäkt ekvation' = "Befintliga kunder: " & FORMAT(([Kundintäkt ingående bas A]-[Kundintäkt föregående])/1000000,"+0.0;−0.0;0.0","sv-SE") & " Mkr · Förändring " & IF(ISBLANK([Kunder befintlig tillväxt]),"Ej jämförbart",FORMAT([Kunder befintlig tillväxt],"+0.0 %;−0.0 %;0.0 %","sv-SE"))
		formatString: General
		displayFolder: Kundanalys
		lineageTag: f25094ce-e931-499f-9a5b-3b1910477b8c

	measure 'Kund omsättning Mkr' = IF([Kundstatus kod]>0,COALESCE([Kund netto A],0)/1000000)
		formatString: 0.0 "Mkr"
		displayFolder: Kundanalys
		lineageTag: 99f11d39-d63c-4f98-8635-8bc7308fa53b

	measure 'Kund förändring kr' = IF([Kundstatus kod]>0,[Kund netto A]-[Kund netto B])
		formatString: #,##0
		displayFolder: Kundanalys
		lineageTag: 9eb149c4-ec3e-41bf-ab9c-465466e37385

	measure 'Kund förändring procent' = IF([Kundstatus kod]>0,DIVIDE([Kund netto A]-[Kund netto B],[Kund netto B]))
		formatString: +0.0 %;−0.0 %;0.0 %
		displayFolder: Kundanalys
		lineageTag: a42df5dc-1a3f-4826-b116-627fd5e89078

	measure 'Kund bruttovinst' = IF([Kund köp A]>0,[Kund netto A]-[Kund kostnad A])
		formatString: #,##0
		displayFolder: Kundanalys
		lineageTag: 970676b1-12ff-46e4-8a4d-89f90e12210f

	measure 'Kund marginal' = DIVIDE([Kund bruttovinst],[Kund netto A])
		formatString: 0.0 %
		displayFolder: Kundanalys
		lineageTag: ba90c864-2830-4442-9286-f3f7f5b800f4

	measure 'Kund senaste köp' = VAR e=[Periodslut] RETURN IF([Kundstatus kod]>0,CALCULATE(MAX('Försäljning'[Datumnyckel]),REMOVEFILTERS('Datum'),'Försäljning'[Nettointäkt]>0,'Försäljning'[Datumnyckel]<=YEAR(e)*10000+MONTH(e)*100+DAY(e)))
		formatString: 0
		displayFolder: Kundanalys
		lineageTag: 4b11bbcc-03e0-44a7-8bd1-ba8086818073

	measure 'Kund senaste köp text' = VAR k=[Kund senaste köp] RETURN IF(NOT ISBLANK(k),FORMAT(DATE(INT(k/10000),INT(MOD(k,10000)/100),MOD(k,100)),"yyyy-MM-dd"))
		formatString: General
		displayFolder: Kundanalys
		lineageTag: 69126066-0354-4be0-9389-b0ae603d5422

	measure 'Kund köpta områden' = VAR s=[Kundperiod start] VAR e=[Periodslut] RETURN IF([Kundstatus kod]>0,CONCATENATEX(FILTER(ALL('Områden'),CALCULATE([Kunder bas],REMOVEFILTERS('Datum'),DATESBETWEEN('Datum'[Datum],s,e))>0),'Områden'[Område],", "))
		formatString: General
		displayFolder: Kundanalys
		lineageTag: e1e644ac-4a91-4744-a2f2-00216c18a9fe

	measure 'Kund prioritet' = ABS([Kund netto A]-[Kund netto B])+ABS([Kund netto A])
		formatString: #,##0
		displayFolder: Kundanalys
		lineageTag: a3c02301-5a03-4b50-b244-8a8ab0bff84c

	measure 'Kund tabell synlig' = VAR _selectedStatus=SELECTEDVALUE('Kundstatusval'[Ordning],0) VAR _customerStatus=[Kundstatus kod] RETURN IF(_customerStatus>0 && (_selectedStatus=0 || _customerStatus=_selectedStatus),1,0)
		formatString: 0
		displayFolder: Kundanalys
		lineageTag: b367b9a8-baf5-4a65-819d-2768670f7813

	measure 'Kund radfärg' = SWITCH([Kundstatus kod],2,"#007956",3,"#4A6BCE",4,"#B42318","#0F3163")
		formatString: General
		displayFolder: Kundanalys
		lineageTag: 3e9bea1c-1705-4205-b912-5141497c76bf

	measure 'Kund detaljrad 1' = IF(HASONEVALUE('Kunder'[Kundnyckel]),SELECTEDVALUE('Kunder'[Kundbransch]) & " · Områden: " & IF([Kundstatus kod]=4,"Inga köp i aktuell period",[Kund köpta områden]),"Skrolla för fler kunder · välj status eller klicka på en kundrad för detaljer.")
		formatString: General
		displayFolder: Kundanalys
		lineageTag: a72873b8-f282-4ef5-a226-1943068c2481

	measure 'Kund detaljrad 2' = IF(HASONEVALUE('Kunder'[Kundnyckel]),"Förändring " & FORMAT([Kund förändring kr],"+0;−0;0","sv-SE") & " kr · Bruttovinst " & FORMAT([Kund bruttovinst]/1000000,"0.00","sv-SE") & " Mkr", "Statusfiltret styr endast kundtabellen. Churn avser hela vald bransch och period.")
		formatString: General
		displayFolder: Kundanalys
		lineageTag: a70fd772-1577-431b-ac2c-a834c754553f

	measure 'Kunder befintlig tillväxt' = IF(ISBLANK([Kunder revenue churn]),BLANK(),-[Kunder revenue churn])
		formatString: +0.0 %;−0.0 %;0.0 %
		displayFolder: Kunder
		lineageTag: 659280de-174f-49ff-909d-cb04442882df

