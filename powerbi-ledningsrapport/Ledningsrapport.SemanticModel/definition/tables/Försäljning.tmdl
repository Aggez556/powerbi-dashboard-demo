	measure 'Kund kostnad B' = VAR s=[Kundperiod föregående start] VAR e=[Kundperiod föregående slut] RETURN CALCULATE([Direkta kostnader bas],REMOVEFILTERS('Datum'),REMOVEFILTERS('Områden'),REMOVEFILTERS('Artiklar'),DATESBETWEEN('Datum'[Datum],s,e))
