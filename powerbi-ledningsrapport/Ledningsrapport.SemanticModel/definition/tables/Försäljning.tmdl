	measure 'Sälj omsättning föregående år' = VAR a=[Sälj områdesval] RETURN IF(a=0,[Nettoomsättning föregående år],CALCULATE([Nettoomsättning föregående år],KEEPFILTERS(TREATAS({a},'Områden'[Områdesnyckel]))))
		formatString: #,##0
