		lineageTag: e41528e7-e475-4b24-80b2-da7d684d9816

	/// Försäljningsöversikt: beräknas från gemensamt underlag och aktuellt områdes-/periodval.
	measure 'Sälj omsättning' = VAR a=[Sälj områdesval] RETURN IF(a=0,[Nettoomsättning],CALCULATE([Nettoomsättning],KEEPFILTERS(TREATAS({a},'Områden'[Områdesnyckel]))))
