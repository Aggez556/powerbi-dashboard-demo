	/// Försäljningsöversikt: beräknas från gemensamt underlag och aktuellt områdes-/periodval.
	measure 'Sälj kort 6 tal' = SWITCH([Sälj områdesval],1,[Sälj ordervärde],2,[Sälj timpris],3,[Sälj timpris],[Sälj omsättning per kund])
		formatString: #,##0.00
		displayFolder: Försäljningsöversikt
		lineageTag: dad4d8b6-b069-4ead-ba36-33981b892416

	/// Försäljningsöversikt: beräknas från gemensamt underlag och aktuellt områdes-/periodval.
	measure 'Sälj kort 6 föregående år' = SWITCH([Sälj områdesval],1,[Sälj ordervärde föregående år],2,[Sälj timpris föregående år],3,[Sälj timpris föregående år],[Sälj omsättning per kund föregående år])
		formatString: #,##0.00
		displayFolder: Försäljningsöversikt
		lineageTag: cfeba134-c2e0-4693-9d8e-19077e92db1b

	/// Försäljningsöversikt: beräknas från gemensamt underlag och aktuellt områdes-/periodval.
	measure 'Sälj kort 5 värde' = IF(ISBLANK([Sälj kort 5 tal]),"—",FORMAT([Sälj kort 5 tal],"# ##0","sv-SE"))
		formatString: General
		displayFolder: Försäljningsöversikt
		lineageTag: 02603a94-9d05-4646-bc11-a914a3bf0ee4

	/// Försäljningsöversikt: beräknas från gemensamt underlag och aktuellt områdes-/periodval.
	measure 'Sälj kort 6 värde' = VAR v=[Sälj kort 6 tal] RETURN IF(ISBLANK(v),"—",IF([Sälj områdesval]<2,FORMAT(v/1000,"0.0","sv-SE") & " tkr",FORMAT(v,"# ##0.0","sv-SE") & " kr"))
		formatString: General
		displayFolder: Försäljningsöversikt
		lineageTag: 5ea4610b-35da-4c62-a938-78b6063e30df

	/// Försäljningsöversikt: beräknas från gemensamt underlag och aktuellt områdes-/periodval.
	measure 'Sälj netto undertext' = "Föregående år: " & FORMAT([Sälj omsättning föregående år]/1000000,"0.0","sv-SE") & " Mkr"
		formatString: General
		displayFolder: Försäljningsöversikt
		lineageTag: 35032674-2db4-4c62-a1b7-6761254dec97

	/// Försäljningsöversikt: beräknas från gemensamt underlag och aktuellt områdes-/periodval.
	measure 'Sälj tillväxt undertext' = FORMAT(([Sälj omsättning]-[Sälj omsättning föregående år])/1000000,"+0.0;−0.0;0.0","sv-SE") & " Mkr mot föregående år"
		formatString: General
		displayFolder: Försäljningsöversikt
		lineageTag: 6134aa75-b13b-4cf9-853d-94d7a9a849bd

	/// Försäljningsöversikt: beräknas från gemensamt underlag och aktuellt områdes-/periodval.
	measure 'Sälj brutto undertext' = "Föregående år: " & FORMAT([Sälj bruttovinst föregående år]/1000000,"0.00","sv-SE") & " Mkr"
		formatString: General
		displayFolder: Försäljningsöversikt
		lineageTag: 322ead5d-ea0c-4084-98e7-0ba24a6f325a

	/// Försäljningsöversikt: beräknas från gemensamt underlag och aktuellt områdes-/periodval.
	measure 'Sälj marginal undertext' = FORMAT(([Sälj bruttomarginal]-[Sälj marginal föregående år])*100,"+0.0;−0.0;0.0","sv-SE") & " procentenheter"
		formatString: General
		displayFolder: Försäljningsöversikt
		lineageTag: 09d2bf3f-50ab-4052-87cc-bcb140226381

	/// Försäljningsöversikt: beräknas från gemensamt underlag och aktuellt områdes-/periodval.
	measure 'Sälj kort 5 undertext' = IF([Sälj områdesval]=0,FORMAT([Sälj kort 5 tal]-[Sälj kort 5 föregående år],"+0;−0;0","sv-SE") & " kunder mot föregående år","Föregående år: " & FORMAT([Sälj kort 5 föregående år],"# ##0","sv-SE"))
		formatString: General
		displayFolder: Försäljningsöversikt
		lineageTag: 78c2f055-e37c-4238-bd49-a1416fb22475

	/// Försäljningsöversikt: beräknas från gemensamt underlag och aktuellt områdes-/periodval.
	measure 'Sälj kort 6 undertext' = VAR v=[Sälj kort 6 föregående år] RETURN IF(ISBLANK(v),"—","Föregående år: " & IF([Sälj områdesval]<2,FORMAT(v/1000,"0.0","sv-SE") & " tkr",FORMAT(v,"# ##0.0","sv-SE") & " kr"))
		formatString: General
		displayFolder: Försäljningsöversikt
		lineageTag: f2dbac6f-7bbe-4cb9-9455-299dcaaaf036

	/// Försäljningsöversikt: beräknas från gemensamt underlag och aktuellt områdes-/periodval.
	measure 'Sälj tillväxt färg' = IF([Sälj tillväxt]<0,"#B42318","#007956")
		formatString: General
		displayFolder: Försäljningsöversikt
		lineageTag: 7b9c4573-7500-47a2-91a6-65f716bfbf01

	/// Försäljningsöversikt: beräknas från gemensamt underlag och aktuellt områdes-/periodval.
	measure 'Sälj marginal färg' = IF([Sälj bruttomarginal]<[Sälj marginal föregående år],"#B42318","#007956")
		formatString: General
		displayFolder: Försäljningsöversikt
		lineageTag: 83933750-b305-43e0-85f6-6f7f8d4997bc

	/// Försäljningsöversikt: beräknas från gemensamt underlag och aktuellt områdes-/periodval.
	measure 'Sälj trend rubrik' = IF([Vald periodtyp]="Månad","Försäljning över tid · historisk kontext","Försäljning över tid")
		formatString: General
		displayFolder: Försäljningsöversikt
		lineageTag: 7431ff1d-d6d0-43f7-bc90-9d6dc4a1c20b

	/// Försäljningsöversikt: beräknas från gemensamt underlag och aktuellt områdes-/periodval.
	measure 'Sälj trend bas' = VAR m=SELECTEDVALUE('Trendaxel'[Månadsstart]) RETURN IF(m>=[Trendstart] && m<=[Periodslut],CALCULATE([Nettoomsättning bas],REMOVEFILTERS('Datum'),DATESBETWEEN('Datum'[Datum],m,EOMONTH(m,0))))
		formatString: #,##0
		displayFolder: Försäljningsöversikt
		lineageTag: 2f4ba3ef-fc5a-40c3-802d-6a2517f665b9

	/// Försäljningsöversikt: beräknas från gemensamt underlag och aktuellt områdes-/periodval.
	measure 'Sälj trend' = VAR a=[Sälj områdesval] VAR typ=SELECTEDVALUE('Försäljningsserie'[Typ]) VAR k=SELECTEDVALUE('Försäljningsserie'[Nyckel]) RETURN SWITCH(TRUE(),a=0 && typ="Område",CALCULATE([Sälj trend bas],KEEPFILTERS(TREATAS({k},'Områden'[Områdesnyckel])))/1000000,a>0 && typ="Kategori",CALCULATE([Sälj trend bas],KEEPFILTERS(TREATAS({a},'Områden'[Områdesnyckel])),KEEPFILTERS(TREATAS({k},'Artiklar'[Kategoriordning])))/1000000)
		formatString: 0.0
		displayFolder: Försäljningsöversikt
		lineageTag: 3bb3762c-31cd-4fc9-b8a6-1d15c39e0fac

	/// Försäljningsöversikt: beräknas från gemensamt underlag och aktuellt områdes-/periodval.
	measure 'Sälj trend föregående år' = VAR m=SELECTEDVALUE('Trendaxel'[Månadsstart]) VAR a=[Sälj områdesval] VAR typ=SELECTEDVALUE('Försäljningsserie'[Typ]) VAR k=SELECTEDVALUE('Försäljningsserie'[Nyckel]) RETURN IF(NOT ISBLANK([Sälj trend]),IF(a=0,CALCULATE([Nettoomsättning bas],REMOVEFILTERS('Datum'),DATESBETWEEN('Datum'[Datum],EDATE(m,-12),EOMONTH(m,-12)),TREATAS({k},'Områden'[Områdesnyckel])),CALCULATE([Nettoomsättning bas],REMOVEFILTERS('Datum'),DATESBETWEEN('Datum'[Datum],EDATE(m,-12),EOMONTH(m,-12)),TREATAS({a},'Områden'[Områdesnyckel]),TREATAS({k},'Artiklar'[Kategoriordning])))/1000000)
		formatString: 0.0
		displayFolder: Försäljningsöversikt
		lineageTag: b2eb041e-0db0-433b-a62d-7b379e9c44a0

	/// Försäljningsöversikt: beräknas från gemensamt underlag och aktuellt områdes-/periodval.
	measure 'Sälj trend vald månad' = IF([Vald periodtyp]="Månad" && EOMONTH(SELECTEDVALUE('Trendaxel'[Månadsstart]),0)=[Periodslut],"Vald månad","")
		formatString: General
		displayFolder: Försäljningsöversikt
		lineageTag: 294cb060-88ab-4cb8-9e6e-02104981c080

	/// Försäljningsöversikt: beräknas från gemensamt underlag och aktuellt områdes-/periodval.
	measure 'Sälj trend färg' = VAR typ=SELECTEDVALUE('Försäljningsserie'[Typ]) VAR k=SELECTEDVALUE('Försäljningsserie'[Nyckel]) RETURN IF([Vald periodtyp]="Månad" && EOMONTH(SELECTEDVALUE('Trendaxel'[Månadsstart]),0)=[Periodslut],"#9B570B",IF(typ="Område",SWITCH(k,1,"#0F3163",2,"#007956",3,"#4A6BCE"),SWITCH(MOD(k-1,3),0,"#0F3163",1,"#007956",2,"#4A6BCE")))
		formatString: General
		displayFolder: Försäljningsöversikt
		lineageTag: 9f127ea6-e7bd-45f8-b56c-15aedf041925

	/// Ger etiketter utrymme ovanför resultatbryggans högsta kumulativa nivå, även vid periodbyte.
	measure 'Bryggans övre axelgräns' = VAR opening=[Rörelseresultat föregående år]/1000000 VAR products=CALCULATE([Bruttovinst]-[Bruttovinst föregående år],'Områden'[Områdesnyckel]=1)/1000000 VAR service=CALCULATE([Bruttovinst]-[Bruttovinst föregående år],'Områden'[Områdesnyckel]=2)/1000000 VAR staffing=CALCULATE([Bruttovinst]-[Bruttovinst föregående år],'Områden'[Områdesnyckel]=3)/1000000 VAR peak=MAXX({opening,opening+products,opening+products+service,opening+products+service+staffing,[Rörelseresultat]/1000000},[Value]) RETURN MAX(peak,0.1)*1.25
		formatString: 0.00
		isHidden
		displayFolder: Presentation
		lineageTag: 7183ca37-b181-4558-8df9-fff95380dde6

