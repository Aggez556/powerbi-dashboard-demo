	measure 'Kund netto B' = VAR s=[Kundperiod föregående start] VAR e=[Kundperiod föregående slut] RETURN CALCULATE([Nettoomsättning bas],REMOVEFILTERS('Datum'),REMOVEFILTERS('Områden'),REMOVEFILTERS('Artiklar'),DATESBETWEEN('Datum'[Datum],s,e))
