		lineageTag: 5860a6c7-efb1-4a7f-825b-f10d77609b73

	/// Försäljningsöversikt: beräknas från gemensamt underlag och aktuellt områdes-/periodval.
	measure 'Sälj bruttovinst' = VAR a=[Sälj områdesval] RETURN IF(a=0,[Bruttovinst],CALCULATE([Bruttovinst],KEEPFILTERS(TREATAS({a},'Områden'[Områdesnyckel]))))
