	/// Försäljningsöversikt: beräknas från gemensamt underlag och aktuellt områdes-/periodval.
	measure 'Produktorder bas' = CALCULATE(DISTINCTCOUNT('Försäljning'[Ordernyckel]),'Försäljning'[Områdesnyckel]=1,'Försäljning'[Nettointäkt]>0)
		formatString: #,##0
		displayFolder: Försäljningsöversikt
		lineageTag: e92abe67-73d8-484b-a4a3-621c92bd1fa1

	/// Försäljningsöversikt: beräknas från gemensamt underlag och aktuellt områdes-/periodval.
	measure 'Orderintäkt bas' = VAR orders=CALCULATETABLE(VALUES('Försäljning'[Ordernyckel]),'Försäljning'[Områdesnyckel]=1,'Försäljning'[Nettointäkt]>0) RETURN CALCULATE(SUM('Försäljning'[Nettointäkt]),KEEPFILTERS(TREATAS(orders,'Försäljning'[Ordernyckel])),'Försäljning'[Områdesnyckel]=1)
		formatString: #,##0
		displayFolder: Försäljningsöversikt
		lineageTag: 41cede9f-0c6a-4e86-b70b-872645a28cc0

	/// Försäljningsöversikt: beräknas från gemensamt underlag och aktuellt områdes-/periodval.
	measure 'Debiterade timmar bas' = CALCULATE(SUM('Försäljning'[Debiterade timmar]),'Försäljning'[Debitering]="Timdebiterat")
		formatString: #,##0.0
		displayFolder: Försäljningsöversikt
		lineageTag: 63d235ee-a0e5-47ca-b7fa-96248f7ccd06

	/// Försäljningsöversikt: beräknas från gemensamt underlag och aktuellt områdes-/periodval.
	measure 'Timintäkt bas' = CALCULATE(SUM('Försäljning'[Nettointäkt]),'Försäljning'[Debitering]="Timdebiterat")
		formatString: #,##0.00
		displayFolder: Försäljningsöversikt
		lineageTag: 952c3bb1-ac8d-4e26-99ed-8d679421871b

	/// Försäljningsöversikt: beräknas från gemensamt underlag och aktuellt områdes-/periodval.
	measure 'Sälj produktorder' = VAR s=[Periodstart] VAR e=[Periodslut] VAR a=[Sälj områdesval] RETURN IF(a=0,CALCULATE([Produktorder bas],REMOVEFILTERS('Datum'),DATESBETWEEN('Datum'[Datum],s,e)),CALCULATE([Produktorder bas],REMOVEFILTERS('Datum'),DATESBETWEEN('Datum'[Datum],s,e),KEEPFILTERS(TREATAS({a},'Områden'[Områdesnyckel]))))
		formatString: #,##0.00
		displayFolder: Försäljningsöversikt
		lineageTag: eebbda62-61f2-4539-b5ec-f6a944ce8ca2

