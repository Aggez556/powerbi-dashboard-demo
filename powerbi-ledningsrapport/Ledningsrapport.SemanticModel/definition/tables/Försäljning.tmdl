	partition Försäljning = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "/Försäljning.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Headers, {{"Fakturarad", Int64.Type}, {"Datumnyckel", Int64.Type}, {"Kundnyckel", Int64.Type}, {"Områdesnyckel", Int64.Type}, {"Nettointäkt", Currency.Type}, {"Typ", type text}, {"Artikelnyckel", Int64.Type}, {"Ordernyckel", Int64.Type}, {"Debitering", type text}, {"Debiterade timmar", Currency.Type}}, "en-US")
				in
					Typed

