	measure 'Kundstatus kod' = VAR a=[Kund köp A]>0 VAR b=[Kund köp B]>0 VAR firstKey=SELECTEDVALUE('Kunder'[Första köp],0) VAR s=[Kundperiod start] VAR previousStart=[Kundperiod föregående start] VAR startKey=YEAR(s)*10000+MONTH(s)*100+DAY(s) VAR priorKey=YEAR(previousStart)*10000+MONTH(previousStart)*100+DAY(previousStart) RETURN SWITCH(TRUE(),a && b,1,a && firstKey>=startKey,2,a && NOT b && firstKey>0 && firstKey<priorKey,3,NOT a && b,4,0)
		formatString: 0
		displayFolder: Kundanalys
		lineageTag: 2e0284ab-bb14-422e-b417-31a1660d6044

