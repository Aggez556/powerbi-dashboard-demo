/// Reproducerbar lokal demodata; Försäljning.csv.
table Försäljning
	lineageTag: 0c6d2c71-19e2-47ce-a69d-fee4b36982a5

	/// Vald periodtyp; räknas från modellen och aktuellt periodval.
	measure 'Vald periodtyp' = SELECTEDVALUE('Periodtyp'[Periodtyp], "R12")
		formatString: General
		displayFolder: Period
		lineageTag: 69917e59-03b9-4f40-8771-c277a913548c

	/// Senaste utfall; räknas från modellen och aktuellt periodval.
	measure 'Senaste utfall' = EOMONTH(MAXX(ALL('Försäljning'), RELATED('Datum'[Datum])),0)
		formatString: yyyy-MM-dd
		displayFolder: Period
		lineageTag: ef9df126-adef-4b1e-99d1-355a72c25012

	/// Periodslut; räknas från modellen och aktuellt periodval.
	measure Periodslut = SWITCH([Vald periodtyp], "Helår", MAX('Helårsval'[Slutdatum]), "Månad", MAX('Månadsval'[Slutdatum]), MAX('R12val'[Slutdatum]))
		formatString: yyyy-MM-dd
		displayFolder: Period
		lineageTag: 6486e349-0387-4fcb-911e-0dbfa20ee097

	/// Periodstart; räknas från modellen och aktuellt periodval.
	measure Periodstart = VAR e=[Periodslut] RETURN SWITCH([Vald periodtyp], "Helår", DATE(YEAR(e),1,1), "Månad", DATE(YEAR(e),MONTH(e),1), EOMONTH(e,-12)+1)
		formatString: yyyy-MM-dd
		displayFolder: Period
		lineageTag: ab8945a3-3f5b-402d-b433-3bfffadcb4db

	/// Jämförelsestart; räknas från modellen och aktuellt periodval.
	measure Jämförelsestart = EDATE([Periodstart],-12)
		formatString: yyyy-MM-dd
		displayFolder: Period
		lineageTag: 90719d10-3cd3-4860-8c0e-f2a6769b0379

	/// Jämförelseslut; räknas från modellen och aktuellt periodval.
	measure Jämförelseslut = EOMONTH([Periodslut],-12)
		formatString: yyyy-MM-dd
		displayFolder: Period
		lineageTag: 541e2097-91b8-4ad8-9a36-410a260eab5c

	/// Periodtext; räknas från modellen och aktuellt periodval.
	measure Periodtext = VAR mode=[Vald periodtyp] VAR currentLabel=SWITCH(mode,"Helår",FORMAT([Periodslut],"yyyy"),"Månad",FORMAT([Periodslut],"MMMM yyyy","sv-SE"),FORMAT([Periodstart],"MMM yyyy","sv-SE") & " – " & FORMAT([Periodslut],"MMM yyyy","sv-SE")) VAR previousLabel=SWITCH(mode,"Helår",FORMAT([Jämförelseslut],"yyyy"),"Månad",FORMAT([Jämförelseslut],"MMMM yyyy","sv-SE"),FORMAT([Jämförelsestart],"MMM yyyy","sv-SE") & " – " & FORMAT([Jämförelseslut],"MMM yyyy","sv-SE")) RETURN "Vald period: " & currentLabel & "    |    Jämför med: " & previousLabel
		formatString: General
		displayFolder: Period
		lineageTag: 49689ec7-9de4-4c4d-a5c3-d1a78d889070

	/// Nettoomsättning bas; räknas från modellen och aktuellt periodval.
	measure 'Nettoomsättning bas' = SUM('Försäljning'[Nettointäkt])
		formatString: #,##0
		isHidden
		displayFolder: Bas
		lineageTag: 8a7deee6-6db8-4591-bb2e-8650d98b3694

	/// Direkta kostnader bas; räknas från modellen och aktuellt periodval.
	measure 'Direkta kostnader bas' = SUM('Direkta kostnader'[Belopp])
		formatString: #,##0
		isHidden
		displayFolder: Bas
		lineageTag: 9d647340-8350-41be-9985-bc6ff46c29d3

	/// Bruttovinst bas; räknas från modellen och aktuellt periodval.
	measure 'Bruttovinst bas' = [Nettoomsättning bas]-[Direkta kostnader bas]
		formatString: #,##0
		isHidden
		displayFolder: Bas
		lineageTag: 0607f508-23e8-4364-9747-f69f99e93cdc

	/// Gemensamma kostnader bas; räknas från modellen och aktuellt periodval.
	measure 'Gemensamma kostnader bas' = SUM('Gemensamma kostnader'[Belopp])
		formatString: #,##0
		isHidden
		displayFolder: Bas
		lineageTag: aed1212e-064c-4223-b35b-c5f1a25ce37d

	/// Rörelseresultat bas; räknas från modellen och aktuellt periodval.
	measure 'Rörelseresultat bas' = [Bruttovinst bas]-[Gemensamma kostnader bas]
		formatString: #,##0
		isHidden
		displayFolder: Bas
		lineageTag: 769ea1ed-dfff-46e1-90b9-33072af6ade3

	/// Budget bas; räknas från modellen och aktuellt periodval.
	measure 'Budget bas' = SUM('Budget'[Rörelseresultat])
		formatString: #,##0
		isHidden
		displayFolder: Bas
		lineageTag: 9de69d3a-7826-47d5-9c51-33bef3c81053

	/// Uppdrag bas; räknas från modellen och aktuellt periodval.
	measure 'Uppdrag bas' = CALCULATE(DISTINCTCOUNT('Uppdrag'[Uppdragsnyckel]), 'Uppdrag'[Status]="Avslutat")
		formatString: #,##0
		isHidden
		displayFolder: Bas
		lineageTag: 8cd9b4a3-5630-406a-838f-0a5bcb4583d6

	/// Kunder bas; räknas från modellen och aktuellt periodval.
	measure 'Kunder bas' = CALCULATE(DISTINCTCOUNT('Försäljning'[Kundnyckel]), 'Försäljning'[Nettointäkt]>0)
		formatString: #,##0
		isHidden
		displayFolder: Bas
		lineageTag: 175a7d44-d8e5-4410-8130-d0bba87a6a73

	/// Nettoomsättning; räknas från modellen och aktuellt periodval.
	measure Nettoomsättning = VAR s=[Periodstart] VAR e=[Periodslut] RETURN CALCULATE([Nettoomsättning bas], REMOVEFILTERS('Datum'), DATESBETWEEN('Datum'[Datum],s,e))
		formatString: #,##0
		displayFolder: Nyckeltal
		lineageTag: 02ec6e35-1dff-43b6-a0dd-fd5633b1e2dd

	/// Nettoomsättning föregående år; räknas från modellen och aktuellt periodval.
	measure 'Nettoomsättning föregående år' = VAR s=[Jämförelsestart] VAR e=[Jämförelseslut] RETURN CALCULATE([Nettoomsättning bas], REMOVEFILTERS('Datum'), DATESBETWEEN('Datum'[Datum],s,e))
		formatString: #,##0
		displayFolder: Nyckeltal
		lineageTag: 876b6f6d-5f76-4b2b-aecc-3f85531c7feb

	/// Bruttovinst; räknas från modellen och aktuellt periodval.
	measure Bruttovinst = VAR s=[Periodstart] VAR e=[Periodslut] RETURN CALCULATE([Bruttovinst bas], REMOVEFILTERS('Datum'), DATESBETWEEN('Datum'[Datum],s,e))
		formatString: #,##0
		displayFolder: Nyckeltal
		lineageTag: e6f07dc9-d82a-4f98-9d1f-9c818ea63063

	/// Bruttovinst föregående år; räknas från modellen och aktuellt periodval.
	measure 'Bruttovinst föregående år' = VAR s=[Jämförelsestart] VAR e=[Jämförelseslut] RETURN CALCULATE([Bruttovinst bas], REMOVEFILTERS('Datum'), DATESBETWEEN('Datum'[Datum],s,e))
		formatString: #,##0
		displayFolder: Nyckeltal
		lineageTag: 48a97d4f-6d10-47e9-aad0-478431876e36

	/// Rörelseresultat; räknas från modellen och aktuellt periodval.
	measure Rörelseresultat = VAR s=[Periodstart] VAR e=[Periodslut] RETURN CALCULATE([Rörelseresultat bas], REMOVEFILTERS('Datum'), DATESBETWEEN('Datum'[Datum],s,e))
		formatString: #,##0
		displayFolder: Nyckeltal
		lineageTag: cf5feac8-1ef7-4734-8e0f-58dd071db518

	/// Rörelseresultat föregående år; räknas från modellen och aktuellt periodval.
	measure 'Rörelseresultat föregående år' = VAR s=[Jämförelsestart] VAR e=[Jämförelseslut] RETURN CALCULATE([Rörelseresultat bas], REMOVEFILTERS('Datum'), DATESBETWEEN('Datum'[Datum],s,e))
		formatString: #,##0
		displayFolder: Nyckeltal
		lineageTag: e5ba6706-61b0-4aca-b192-edbc7af5969c

	/// Gemensamma kostnader; räknas från modellen och aktuellt periodval.
	measure 'Gemensamma kostnader' = VAR s=[Periodstart] VAR e=[Periodslut] RETURN CALCULATE([Gemensamma kostnader bas], REMOVEFILTERS('Datum'), DATESBETWEEN('Datum'[Datum],s,e))
		formatString: #,##0
		displayFolder: Nyckeltal
		lineageTag: 27fd7737-bfef-4fc3-b279-3d7993bed0bf

	/// Gemensamma kostnader föregående år; räknas från modellen och aktuellt periodval.
	measure 'Gemensamma kostnader föregående år' = VAR s=[Jämförelsestart] VAR e=[Jämförelseslut] RETURN CALCULATE([Gemensamma kostnader bas], REMOVEFILTERS('Datum'), DATESBETWEEN('Datum'[Datum],s,e))
		formatString: #,##0
		displayFolder: Nyckeltal
		lineageTag: afd8822c-03f3-4752-a265-c24be556ea37

	/// Budgetresultat; räknas från modellen och aktuellt periodval.
	measure Budgetresultat = VAR s=[Periodstart] VAR e=[Periodslut] RETURN CALCULATE([Budget bas], REMOVEFILTERS('Datum'), DATESBETWEEN('Datum'[Datum],s,e))
		formatString: #,##0
		displayFolder: Nyckeltal
		lineageTag: 0ce7950c-ee0c-4979-9c61-f73caabb31e2

	/// Budgetresultat föregående år; räknas från modellen och aktuellt periodval.
	measure 'Budgetresultat föregående år' = VAR s=[Jämförelsestart] VAR e=[Jämförelseslut] RETURN CALCULATE([Budget bas], REMOVEFILTERS('Datum'), DATESBETWEEN('Datum'[Datum],s,e))
		formatString: #,##0
		displayFolder: Nyckeltal
		lineageTag: 94b7b68e-c05b-4687-b0ac-45dbcb504b47

	/// Utförda uppdrag; räknas från modellen och aktuellt periodval.
	measure 'Utförda uppdrag' = IF(SELECTEDVALUE('Områden'[Områdesnyckel])=1, BLANK(), VAR s=[Periodstart] VAR e=[Periodslut] RETURN CALCULATE([Uppdrag bas], REMOVEFILTERS('Datum'), DATESBETWEEN('Datum'[Datum],s,e)))
		formatString: #,##0
		displayFolder: Nyckeltal
		lineageTag: 3177020c-6d04-452f-aaee-6bc808c30c2a

	/// Utförda uppdrag föregående år; räknas från modellen och aktuellt periodval.
	measure 'Utförda uppdrag föregående år' = IF(SELECTEDVALUE('Områden'[Områdesnyckel])=1, BLANK(), VAR s=[Jämförelsestart] VAR e=[Jämförelseslut] RETURN CALCULATE([Uppdrag bas], REMOVEFILTERS('Datum'), DATESBETWEEN('Datum'[Datum],s,e)))
		formatString: #,##0
		displayFolder: Nyckeltal
		lineageTag: 126d8971-6531-42d0-9603-210288a667fe

	/// Aktiva kunder; räknas från modellen och aktuellt periodval.
	measure 'Aktiva kunder' = VAR s=[Periodstart] VAR e=[Periodslut] RETURN CALCULATE([Kunder bas], REMOVEFILTERS('Datum'), DATESBETWEEN('Datum'[Datum],s,e))
		formatString: #,##0
		displayFolder: Nyckeltal
		lineageTag: 9c15faae-9b58-4a86-b8b9-e5bfbeeb7484

	/// Aktiva kunder föregående år; räknas från modellen och aktuellt periodval.
	measure 'Aktiva kunder föregående år' = VAR s=[Jämförelsestart] VAR e=[Jämförelseslut] RETURN CALCULATE([Kunder bas], REMOVEFILTERS('Datum'), DATESBETWEEN('Datum'[Datum],s,e))
		formatString: #,##0
		displayFolder: Nyckeltal
		lineageTag: 57d19fb6-d116-4ac9-a12e-bb49d00a151e

	/// Bruttomarginal; räknas från modellen och aktuellt periodval.
	measure Bruttomarginal = DIVIDE([Bruttovinst],[Nettoomsättning])
		formatString: 0.0 %
		displayFolder: Nyckeltal
		lineageTag: 119ef906-b74d-4359-93ee-1e72b5ac74fb

	/// Rörelsemarginal; räknas från modellen och aktuellt periodval.
	measure Rörelsemarginal = DIVIDE([Rörelseresultat],[Nettoomsättning])
		formatString: 0.0 %
		displayFolder: Nyckeltal
		lineageTag: d7084d3f-c9bb-47ea-b0bb-cbb1cbf49829

	/// Resultat mot budget; räknas från modellen och aktuellt periodval.
	measure 'Resultat mot budget' = [Rörelseresultat]-[Budgetresultat]
		formatString: #,##0
		displayFolder: Nyckeltal
		lineageTag: 60a5c472-d76b-4b97-aa4b-f7e5bb1f9050

	/// Nettoomsättning Mkr; räknas från modellen och aktuellt periodval.
	measure 'Nettoomsättning Mkr' = [Nettoomsättning]/1000000
		formatString: 0.0 "Mkr"
		displayFolder: Visning
		lineageTag: 39f2d543-cc35-448e-9d20-f28e81c75907

	/// Bruttovinst Mkr; räknas från modellen och aktuellt periodval.
	measure 'Bruttovinst Mkr' = [Bruttovinst]/1000000
		formatString: 0.00 "Mkr"
		displayFolder: Visning
		lineageTag: d7d672d0-4d41-4adb-a157-02bf5727bc75

	/// Rörelseresultat Mkr; räknas från modellen och aktuellt periodval.
	measure 'Rörelseresultat Mkr' = [Rörelseresultat]/1000000
		formatString: 0.00 "Mkr"
		displayFolder: Visning
		lineageTag: 87f86fc9-768c-43b6-9566-2235b6fc5837

	/// Budgetresultat Mkr; räknas från modellen och aktuellt periodval.
	measure 'Budgetresultat Mkr' = [Budgetresultat]/1000000
		formatString: 0.00 "Mkr"
		displayFolder: Visning
		lineageTag: 57296ef4-1ae4-4e9d-ae92-bea2d288c186

	/// Resultat mot budget Mkr; räknas från modellen och aktuellt periodval.
	measure 'Resultat mot budget Mkr' = [Resultat mot budget]/1000000
		formatString: 0.00 "Mkr"
		displayFolder: Visning
		lineageTag: 45fe6b26-127e-4655-bcd4-a1d26ba1f770

	/// Nettoomsättning förändring; räknas från modellen och aktuellt periodval.
	measure 'Nettoomsättning förändring' = DIVIDE([Nettoomsättning]-[Nettoomsättning föregående år],[Nettoomsättning föregående år])
		formatString: +0.0 %;-0.0 %;0.0 %
		displayFolder: Nyckeltal
		lineageTag: e68eed0f-4bb2-4068-9276-202cd47b89e3

	/// Nettoomsättning jämförelsetext; räknas från modellen och aktuellt periodval.
	measure 'Nettoomsättning jämförelsetext' = FORMAT([Nettoomsättning förändring],"+0.0 %;−0.0 %;0.0 %","sv-SE") & " mot föregående år"
		formatString: General
		displayFolder: Visning
		lineageTag: 32aefc55-baa9-413b-bb97-4a9960b1f074

	/// Rörelseresultat förändring; räknas från modellen och aktuellt periodval.
	measure 'Rörelseresultat förändring' = DIVIDE([Rörelseresultat]-[Rörelseresultat föregående år],[Rörelseresultat föregående år])
		formatString: +0.0 %;-0.0 %;0.0 %
		displayFolder: Nyckeltal
		lineageTag: 52846588-2883-47cc-9671-a61e2bbd157d

	/// Rörelseresultat jämförelsetext; räknas från modellen och aktuellt periodval.
	measure 'Rörelseresultat jämförelsetext' = FORMAT([Rörelseresultat förändring],"+0.0 %;−0.0 %;0.0 %","sv-SE") & " mot föregående år"
		formatString: General
		displayFolder: Visning
		lineageTag: 56dd30f9-bdc7-43ae-b3a4-d29304014a2e

	/// Utförda uppdrag förändring; räknas från modellen och aktuellt periodval.
	measure 'Utförda uppdrag förändring' = DIVIDE([Utförda uppdrag]-[Utförda uppdrag föregående år],[Utförda uppdrag föregående år])
		formatString: +0.0 %;-0.0 %;0.0 %
		displayFolder: Nyckeltal
		lineageTag: 76a8449e-cf15-4402-a8e9-42cc337d1008

	/// Utförda uppdrag jämförelsetext; räknas från modellen och aktuellt periodval.
	measure 'Utförda uppdrag jämförelsetext' = FORMAT([Utförda uppdrag förändring],"+0.0 %;−0.0 %;0.0 %","sv-SE") & " mot föregående år"
		formatString: General
		displayFolder: Visning
		lineageTag: ba8be843-650f-4473-9e2a-213db3f127c1

	/// Bruttovinst undertext; räknas från modellen och aktuellt periodval.
	measure 'Bruttovinst undertext' = FORMAT([Bruttomarginal],"0.0 %","sv-SE") & " bruttomarginal"
		formatString: General
		displayFolder: Visning
		lineageTag: a1f9677e-f186-48db-80f1-e7098a80a2c2

	/// Rörelseresultat undertext; räknas från modellen och aktuellt periodval.
	measure 'Rörelseresultat undertext' = FORMAT([Rörelsemarginal],"0.0 %","sv-SE") & " marginal · " & FORMAT([Rörelseresultat förändring],"+0.0 %;−0.0 %;0.0 %","sv-SE") & " mot föregående år"
		formatString: General
		displayFolder: Visning
		lineageTag: 7da33be9-21b5-40aa-bc77-63e73fe3956a

	/// Budget undertext; räknas från modellen och aktuellt periodval.
	measure 'Budget undertext' = "Budget: " & FORMAT([Budgetresultat Mkr],"0.00","sv-SE") & " Mkr"
		formatString: General
		displayFolder: Visning
		lineageTag: 0eaba236-849c-450a-87fd-35fca779626d

	/// Kunder undertext; räknas från modellen och aktuellt periodval.
	measure 'Kunder undertext' = FORMAT([Aktiva kunder]-[Aktiva kunder föregående år],"+0;−0;0","sv-SE") & " kunder mot föregående år"
		formatString: General
		displayFolder: Visning
		lineageTag: 9456a35d-8718-45c4-89e9-1e9e8b0c41c3

	/// Budgetfärg; räknas från modellen och aktuellt periodval.
	measure Budgetfärg = IF([Resultat mot budget]<0,"#B42318","#007956")
		formatString: General
		displayFolder: Visning
		lineageTag: 465b7fa5-ccea-40ca-8e0b-f15b89b98726

	/// Nettoomsättning statusfärg; räknas från modellen och aktuellt periodval.
	measure 'Nettoomsättning statusfärg' = IF([Nettoomsättning förändring]<0,"#B42318","#007956")
		formatString: General
		displayFolder: Visning
		lineageTag: b766298d-5d4a-49cb-bcbc-4d74536c90bc

	/// Rörelseresultat statusfärg; räknas från modellen och aktuellt periodval.
	measure 'Rörelseresultat statusfärg' = IF([Rörelseresultat förändring]<0,"#B42318","#007956")
		formatString: General
		displayFolder: Visning
		lineageTag: b5dc96a6-5ad3-4aef-8b48-7c6ea5ec5cf0

	/// Utförda uppdrag statusfärg; räknas från modellen och aktuellt periodval.
	measure 'Utförda uppdrag statusfärg' = IF([Utförda uppdrag förändring]<0,"#B42318","#007956")
		formatString: General
		displayFolder: Visning
		lineageTag: 5f15aca8-0c53-4f9c-9a8e-522f53d85ebf

	/// Trendstart; räknas från modellen och aktuellt periodval.
	measure Trendstart = IF([Vald periodtyp]="Helår",[Periodstart],EOMONTH([Periodslut],-12)+1)
		formatString: yyyy-MM-dd
		displayFolder: Trend
		lineageTag: 92b6d24a-0232-479b-adac-4c6492d914cd

	/// Trendrubrik; räknas från modellen och aktuellt periodval.
	measure Trendrubrik = IF([Vald periodtyp]="Månad","Omsättning och rörelsemarginal · historisk kontext","Omsättning och rörelsemarginal")
		formatString: General
		displayFolder: Trend
		lineageTag: 6f1bc4ae-0221-4c7f-8825-ce4c536499a6

	/// Uppdragsrubrik; räknas från modellen och aktuellt periodval.
	measure Uppdragsrubrik = IF([Vald periodtyp]="Månad","Utförda uppdrag per månad · historisk kontext","Utförda uppdrag per månad")
		formatString: General
		displayFolder: Trend
		lineageTag: 687c3138-0e83-4c83-aa76-ddba1f021cda

	/// Trendomsättning; räknas från modellen och aktuellt periodval.
	measure Trendomsättning = VAR m=SELECTEDVALUE('Trendaxel'[Månadsstart]) RETURN IF(m>=[Trendstart] && m<=[Periodslut], CALCULATE([Nettoomsättning bas], REMOVEFILTERS('Datum'), DATESBETWEEN('Datum'[Datum],m,EOMONTH(m,0))))
		formatString: #,##0
		displayFolder: Trend
		lineageTag: bebd08d7-00c3-4ca4-bd53-7d351222669d

	/// Trendresultat; räknas från modellen och aktuellt periodval.
	measure Trendresultat = VAR m=SELECTEDVALUE('Trendaxel'[Månadsstart]) RETURN IF(m>=[Trendstart] && m<=[Periodslut], CALCULATE([Rörelseresultat bas], REMOVEFILTERS('Datum'), DATESBETWEEN('Datum'[Datum],m,EOMONTH(m,0))))
		formatString: #,##0
		displayFolder: Trend
		lineageTag: 2cc35753-9419-4694-b6e4-2fb266dea09c

	/// Trenduppdrag; räknas från modellen och aktuellt periodval.
	measure Trenduppdrag = VAR m=SELECTEDVALUE('Trendaxel'[Månadsstart]) RETURN IF(m>=[Trendstart] && m<=[Periodslut], CALCULATE([Uppdrag bas], REMOVEFILTERS('Datum'), DATESBETWEEN('Datum'[Datum],m,EOMONTH(m,0))))
		formatString: #,##0
		displayFolder: Trend
		lineageTag: 281750cf-dcb2-42b0-ba19-5c2062028614

	/// Omsättning; räknas från modellen och aktuellt periodval.
	measure Omsättning = [Trendomsättning]/1000000
		formatString: 0.0
		displayFolder: Trend
		lineageTag: 86734b24-e65f-4388-8b0b-ccc65c7b0d22

	/// Rörelsemarginal trend; räknas från modellen och aktuellt periodval.
	measure 'Rörelsemarginal trend' = DIVIDE([Trendresultat],[Trendomsättning])*100
		formatString: 0.0
		displayFolder: Trend
		lineageTag: 0fb0d696-a5b7-4b90-a617-d7cbbc6f273a

	/// Teknisk service; räknas från modellen och aktuellt periodval.
	measure 'Teknisk service' = CALCULATE([Trenduppdrag],'Områden'[Områdesnyckel]=2)
		formatString: #,##0
		displayFolder: Trend
		lineageTag: a5fcb981-d888-43f1-8edc-48016efa3ec4

	/// Bemanning; räknas från modellen och aktuellt periodval.
	measure Bemanning = CALCULATE([Trenduppdrag],'Områden'[Områdesnyckel]=3)
		formatString: #,##0
		displayFolder: Trend
		lineageTag: ac408d01-7b18-4856-9c3c-d093c335c464

	/// Vald månadsmarkering; räknas från modellen och aktuellt periodval.
	measure 'Vald månadsmarkering' = IF([Vald periodtyp]="Månad" && EOMONTH(SELECTEDVALUE('Trendaxel'[Månadsstart]),0)=[Periodslut], [Rörelsemarginal trend])
		formatString: 0.0
		displayFolder: Trend
		lineageTag: 403a909a-5686-423f-a872-8157bd253c85

	/// Trendfärg; räknas från modellen och aktuellt periodval.
	measure Trendfärg = IF([Vald periodtyp]="Månad" && EOMONTH(SELECTEDVALUE('Trendaxel'[Månadsstart]),0)=[Periodslut],"#9B570B","#0F3163")
		formatString: General
		displayFolder: Trend
		lineageTag: ab069cf3-11f8-4f74-bdb4-efa004a231a0

	/// Trendomsättning föregående år; räknas från modellen och aktuellt periodval.
	measure 'Trendomsättning föregående år' = VAR m=SELECTEDVALUE('Trendaxel'[Månadsstart]) RETURN IF(NOT ISBLANK([Trendomsättning]), CALCULATE([Nettoomsättning bas], REMOVEFILTERS('Datum'), DATESBETWEEN('Datum'[Datum],EDATE(m,-12),EOMONTH(m,-12))))
		formatString: #,##0
		displayFolder: Trend
		lineageTag: 70a9d65e-654c-4fb2-8507-b7ed9b8ec549

	/// Trendomsättning förändring; räknas från modellen och aktuellt periodval.
	measure 'Trendomsättning förändring' = DIVIDE([Trendomsättning]-[Trendomsättning föregående år],[Trendomsättning föregående år])
		formatString: +0.0 %;-0.0 %;0.0 %
		displayFolder: Trend
		lineageTag: 918331eb-15c8-4d8e-91b5-8c265558f233

	/// Bryggsteg; räknas från modellen och aktuellt periodval.
	measure Bryggsteg = VAR t=[Vald periodtyp] VAR e=[Periodslut] VAR step=SELECTEDVALUE('Bryggaxel'[Ordning]) VAR valid=CALCULATE(COUNTROWS('Bryggaxel'),'Bryggaxel'[Periodtyp]=t,'Bryggaxel'[Slutdatum]=e) RETURN IF(valid>0, SWITCH(step,0,[Rörelseresultat föregående år],1,CALCULATE([Bruttovinst]-[Bruttovinst föregående år],'Områden'[Områdesnyckel]=1),2,CALCULATE([Bruttovinst]-[Bruttovinst föregående år],'Områden'[Områdesnyckel]=2),3,CALCULATE([Bruttovinst]-[Bruttovinst föregående år],'Områden'[Områdesnyckel]=3),4,-([Gemensamma kostnader]-[Gemensamma kostnader föregående år])))/1000000
		formatString: 0.00
		displayFolder: Brygga
		lineageTag: 42c967bb-860f-40b3-a294-46119036819a

	/// Bryggans slutetikett; räknas från modellen och aktuellt periodval.
	measure 'Bryggans slutetikett' = IF([Vald periodtyp]="Helår",FORMAT([Periodslut],"yyyy"),IF([Vald periodtyp]="R12","R12 ","") & FORMAT([Periodslut],"MMM yyyy","sv-SE"))
		formatString: General
		displayFolder: Brygga
		lineageTag: 9d56a182-2e3c-46df-8355-05ea4edd8d9a

	/// Bryggkontroll; räknas från modellen och aktuellt periodval.
	measure Bryggkontroll = [Rörelseresultat föregående år]+SUMX(ALL('Områden'),[Bruttovinst]-[Bruttovinst föregående år])-([Gemensamma kostnader]-[Gemensamma kostnader föregående år])-[Rörelseresultat]
		formatString: 0
		isHidden
		displayFolder: Kontroller
		lineageTag: c6b21b5f-fd10-42e9-9059-ecc31eb6d9b1

	/// Källfält i lokal demodata: Försäljning.Fakturarad.
	/// Visning på en egen textrad i KPI-kort.
	measure 'Rörelsemarginal korttext' = FORMAT([Rörelsemarginal],"0.0 %","sv-SE") & " marginal · " & FORMAT([Rörelseresultat förändring],"+0.0 %;−0.0 %;0.0 %","sv-SE")
		formatString: General
		displayFolder: Visning
		lineageTag: ddaa1a39-85cd-4198-bc57-40d785f72ecd

	/// Visning på en egen textrad i KPI-kort.
	measure 'Kundförändring korttext' = FORMAT([Aktiva kunder]-[Aktiva kunder föregående år],"+0;−0;0","sv-SE") & " mot föregående år"
		formatString: General
		displayFolder: Visning
		lineageTag: 5aaeb1f4-8f84-49bb-a408-0f6adc21c44e

	/// Försäljningsöversikt: beräknas från gemensamt underlag och aktuellt områdes-/periodval.
	measure 'Sälj områdesval' = SELECTEDVALUE('Områdesval'[Områdesval],0)
