	measure 'Kund köp B' = VAR s=[Kundperiod föregående start] VAR e=[Kundperiod föregående slut] RETURN CALCULATE([Kunder bas],REMOVEFILTERS('Datum'),REMOVEFILTERS('Områden'),REMOVEFILTERS('Artiklar'),DATESBETWEEN('Datum'[Datum],s,e))
