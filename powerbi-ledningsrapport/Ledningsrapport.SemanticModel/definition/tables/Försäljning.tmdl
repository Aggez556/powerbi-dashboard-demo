		lineageTag: 8042532e-971c-4181-befc-39757b1869b8

	/// Försäljningsöversikt: beräknas från gemensamt underlag och aktuellt områdes-/periodval.
	measure 'Sälj kunder' = VAR a=[Sälj områdesval] RETURN IF(a=0,[Aktiva kunder],CALCULATE([Aktiva kunder],KEEPFILTERS(TREATAS({a},'Områden'[Områdesnyckel]))))
