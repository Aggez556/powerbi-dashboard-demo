		lineageTag: c4c86c91-3725-42e7-9156-585d757bbd8b
		summarizeBy: none
		sourceColumn: Undergrupp

	column Post
		dataType: string
		lineageTag: d1c7d45c-66fd-4201-b877-e41dd44e710f
