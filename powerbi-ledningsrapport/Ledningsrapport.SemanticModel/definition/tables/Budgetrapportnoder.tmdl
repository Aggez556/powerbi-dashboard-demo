		lineageTag: 4e28c525-b2c3-4ffb-a787-b4c85a0fb0a3
		summarizeBy: none
		sourceColumn: Nivå

	column Typ
		dataType: string
		lineageTag: 0897eda5-a23c-4681-aa0a-e7a751ac1de5
