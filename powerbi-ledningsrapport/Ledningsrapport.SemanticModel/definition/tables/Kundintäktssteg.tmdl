/// Frikopplad presentationsaxel för kundanalys.
table Kundintäktssteg
	lineageTag: 096c5e8c-36db-401c-915b-165494d8f168

	column Steg
		dataType: string
		lineageTag: 56b55aaa-e9a3-4b98-a584-ceb5b45ad614
		summarizeBy: none
		sourceColumn: Steg
		sortByColumn: Ordning

	column Ordning
		dataType: int64
		isHidden
		lineageTag: a9bd4434-e8df-40cc-a46b-e4d944a59d42
		summarizeBy: none
		sourceColumn: Ordning

	partition Kundintäktssteg = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "/Kundintäktssteg.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Headers, {{"Steg", type text}, {"Ordning", Int64.Type}}, "en-US")
				in
					Typed

