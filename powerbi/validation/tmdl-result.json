{
    "libraryVersion":  "19.84.1.0",
    "modelMetadata":  [
                          {
                              "measures":  [
                                               {
                                                   "name":  "Planering bas",
                                                   "formatString":  "#,##0;-#,##0;\" \"",
                                                   "expression":  "VAR PY = [Omsättning föregående år]\nRETURN COALESCE(PY, [Omsättning])"
                                               },
                                               {
                                                   "name":  "Planering justerad",
                                                   "formatString":  "#,##0;-#,##0;\" \"",
                                                   "expression":  "[Planering bas] * (1 + DIVIDE(SELECTEDVALUE(\u0027Budgetjustering\u0027[Procent], 3), 100))"
                                               },
                                               {
                                                   "name":  "Planerad omsättning",
                                                   "formatString":  "#,##0;-#,##0;\" \"",
                                                   "expression":  "VAR Bas = [Planering bas]\nVAR AnnualBase = CALCULATE([Planering bas], ALLEXCEPT(\u0027Datum\u0027, \u0027Datum\u0027[År]))\nVAR MonthCount = COUNTROWS(VALUES(\u0027Datum\u0027[Månadsnummer]))\nVAR EvenSpread = SELECTEDVALUE(\u0027Budgetfördelning\u0027[Fördelning], \"Fördela över hela året\") = \"Fördela över hela året\"\nVAR Vikt = IF(EvenSpread, DIVIDE(MonthCount, 12), DIVIDE(Bas, AnnualBase))\nVAR AnnualAmount = SELECTEDVALUE(\u0027Budgetbelopp\u0027[Belopp], 0)\nRETURN (IF(EvenSpread, AnnualBase * DIVIDE(MonthCount, 12), Bas) * SELECTEDVALUE(\u0027Budgetscenario\u0027[Faktor], 1.05) * (1 + DIVIDE(SELECTEDVALUE(\u0027Budgetjustering\u0027[Procent], 3), 100))) + AnnualAmount * Vikt"
                                               },
                                               {
                                                   "name":  "Resultat utfall",
                                                   "formatString":  "#,##0;-#,##0;\" \"",
                                                   "expression":  "VAR Kod = SELECTEDVALUE(\u0027Resultatrader\u0027[Beräkning])\nVAR SelectedVersion = SELECTEDVALUE(\u0027Budgetversion\u0027[Version], \"Actuals\")\nVAR RevenueValue = SWITCH(SelectedVersion, \"Actuals PY\", [Omsättning föregående år], \"Max YTD PY\", CALCULATE([Omsättning föregående år], DATESYTD(\u0027Datum\u0027[Datum])), \"Budget\", [Planerad omsättning], [Omsättning])\nVAR Varukostnad = SWITCH(SelectedVersion, \"Actuals PY\", CALCULATE([Kostnad], SAMEPERIODLASTYEAR(\u0027Datum\u0027[Datum])), \"Max YTD PY\", CALCULATE([Kostnad], SAMEPERIODLASTYEAR(DATESYTD(\u0027Datum\u0027[Datum]))), \"Budget\", RevenueValue * 0.73, [Kostnad])\nRETURN SWITCH(Kod, 0, 0, 1, RevenueValue, 2, RevenueValue * 0.04, 3, RevenueValue * 1.04, 4, -Varukostnad, 5, -RevenueValue * 0.08, 6, -RevenueValue * 0.12, 7, -Varukostnad - RevenueValue * 0.20, 8, RevenueValue * 0.84 - Varukostnad, 9, -RevenueValue * 0.03, 10, RevenueValue * 0.81 - Varukostnad)"
                                               },
                                               {
                                                   "name":  "Resultat budget",
                                                   "formatString":  "#,##0;-#,##0;\" \"",
                                                   "expression":  "VAR Kod = SELECTEDVALUE(\u0027Resultatrader\u0027[Beräkning])\nVAR RevenueValue = [Planerad omsättning]\nRETURN SWITCH(Kod, 0, 0, 1, RevenueValue, 2, RevenueValue * 0.04, 3, RevenueValue * 1.04, 4, -RevenueValue * 0.73, 5, -RevenueValue * 0.08, 6, -RevenueValue * 0.12, 7, -RevenueValue * 0.93, 8, RevenueValue * 0.11, 9, -RevenueValue * 0.03, 10, RevenueValue * 0.08)"
                                               },
                                               {
                                                   "name":  "Resultatrad bakgrund",
                                                   "formatString":  "@",
                                                   "expression":  "VAR Rad = SELECTEDVALUE(\u0027Resultatrader\u0027[Rad])\nRETURN IF(LEFT(Rad, 5) = \"Summa\" || Rad IN {\"Resultat före avskrivningar\", \"Rörelseresultat\"}, \"#E1E8F2\", \"#FFFFFF\")"
                                               },
                                               {
                                                   "name":  "Omsättning",
                                                   "formatString":  "#,##0.00 \" kr\"",
                                                   "expression":  "SUM(\u0027Försäljning\u0027[Radomsättning])"
                                               },
                                               {
                                                   "name":  "Kostnad",
                                                   "formatString":  "#,##0.00 \" kr\"",
                                                   "expression":  "SUM(\u0027Försäljning\u0027[Radkostnad])"
                                               },
                                               {
                                                   "name":  "Bruttovinst",
                                                   "formatString":  "#,##0.00 \" kr\"",
                                                   "expression":  "[Omsättning] - [Kostnad]"
                                               },
                                               {
                                                   "name":  "Bruttomarginal",
                                                   "formatString":  "0.0 %",
                                                   "expression":  "DIVIDE([Bruttovinst], [Omsättning])"
                                               },
                                               {
                                                   "name":  "Antal order",
                                                   "formatString":  "#,##0",
                                                   "expression":  "DISTINCTCOUNT(\u0027Försäljning\u0027[Ordernyckel])"
                                               },
                                               {
                                                   "name":  "Omsättning föregående år",
                                                   "formatString":  "#,##0.00 \" kr\"",
                                                   "expression":  "CALCULATE([Omsättning], SAMEPERIODLASTYEAR(\u0027Datum\u0027[Datum]))"
                                               },
                                               {
                                                   "name":  "Tillväxt mot föregående år",
                                                   "formatString":  "0.0 %;-0.0 %;0.0 %",
                                                   "expression":  "IF(HASONEVALUE(\u0027Datum\u0027[År]), DIVIDE([Omsättning] - [Omsättning föregående år], [Omsättning föregående år]), BLANK())"
                                               },
                                               {
                                                   "name":  "Antal orderrader",
                                                   "formatString":  "#,##0",
                                                   "expression":  "COUNTROWS(\u0027Försäljning\u0027)"
                                               },
                                               {
                                                   "name":  "Kundrankning",
                                                   "formatString":  "0",
                                                   "expression":  "RANKX(ALLSELECTED(\u0027Kunder\u0027[Kund]), [Omsättning], , DESC, DENSE)"
                                               }
                                           ],
