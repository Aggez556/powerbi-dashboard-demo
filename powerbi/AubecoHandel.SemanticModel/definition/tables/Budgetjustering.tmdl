/// Fristående tabell för lokal budgetsimulering.
table Budgetjustering

	column Procent
		dataType: int64
		summarizeBy: none
		sourceColumn: Procent

	partition Budgetjustering = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "/Budgetjustering.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Headers, {{"Procent", Int64.Type}}, "en-US")
				in
					Typed

