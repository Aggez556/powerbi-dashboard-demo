/// Fristående tabell för lokal budgetsimulering.
table Budgetfördelning

	column Fördelning
		dataType: string
		summarizeBy: none
		sourceColumn: Fördelning

	partition Budgetfördelning = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "/Budgetfördelning.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Headers, {{"Fördelning", type text}}, "en-US")
				in
					Typed

